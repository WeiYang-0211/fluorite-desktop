<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Launchpad.Views.LaunchpadWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:viewmodels="clr-namespace:Launchpad.ViewModels" xmlns:models="clr-namespace:Launchpad.Models" xmlns:infra="clr-namespace:Launchpad.Infrastructure" xmlns:views="clr-namespace:Launchpad.Views" Title="Fluorite" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="False" Background="{DynamicResource T.Window_FF}" ShowInTaskbar="False" Topmost="True" Focusable="True" FontFamily="{DynamicResource AppFont}" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" UseLayoutRounding="True" AllowDrop="True" PreviewDragEnter="OnWindowPreviewDragEnter" PreviewDragOver="OnWindowPreviewDragOver" PreviewDragLeave="OnWindowPreviewDragLeave" PreviewDrop="OnWindowPreviewDrop">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Fluorite;component/Resources/Styles.xaml" />
        <ResourceDictionary Source="/Fluorite;component/Resources/SettingsStyles.xaml" />
        <ResourceDictionary Source="/Fluorite;component/Resources/ProWorkspaceStyles.xaml" />
        <views:AppTileResources />
      </ResourceDictionary.MergedDictionaries>
      <ImageBrush x:Key="DockFrost" Stretch="Fill" ViewboxUnits="Absolute" ViewportUnits="Absolute" />
      <DataTemplate x:Key="IconLockRow">
        <Border Style="{StaticResource SRowItem}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
              <TextBlock Text="锁定图标" Style="{StaticResource STitle}" />
              <TextBlock Text="禁止拖动排序，点击和滑动翻页仍可用 · Ctrl + Shift + L" Margin="0,4,0,0" TextWrapping="Wrap" Style="{StaticResource SHint}" />
            </StackPanel>
            <ToggleButton Grid.Column="1" Style="{StaticResource MacSwitch}" IsChecked="{Binding Settings.IconsLocked, Mode=TwoWay}" />
          </Grid>
        </Border>
      </DataTemplate>
      <DataTemplate x:Key="DesktopResidentRow">
        <StackPanel>
          <TextBlock Text="桌面常驻与临时置顶" FontWeight="SemiBold" Margin="2,4,0,6" Style="{StaticResource SHint}" />
          <Border Style="{StaticResource SGroup}">
            <StackPanel>
              <Border Style="{StaticResource SRowItem}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                    <TextBlock Text="在桌面常驻启动台" Style="{StaticResource STitle}" />
                    <TextBlock Text="显示在桌面上、应用窗口后面；启动应用后不收起。关闭可恢复原有行为。" TextWrapping="Wrap" Margin="0,4,0,0" Style="{StaticResource SHint}" />
                  </StackPanel>
                  <ToggleButton Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource MacSwitch}" IsChecked="{Binding Settings.DesktopResidentLaunchpad, Mode=TwoWay}" />
                </Grid>
              </Border>
              <Border Style="{StaticResource SDivider}" Visibility="{Binding Settings.DesktopResidentLaunchpad, Converter={StaticResource Bool2Vis}}" />
              <Border Style="{StaticResource SRowItem}" Visibility="{Binding Settings.DesktopResidentLaunchpad, Converter={StaticResource Bool2Vis}}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
                    <TextBlock Text="置顶后自动贴回桌面" Style="{StaticResource STitle}" />
                    <TextBlock Text="启动应用或文件、点击空白处或按 Esc 后取消置顶；打开文件夹时保留置顶。" TextWrapping="Wrap" Margin="0,4,0,0" Style="{StaticResource SHint}" />
                  </StackPanel>
                  <ToggleButton Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource MacSwitch}" IsChecked="{Binding Settings.AutoUnpinResidentLaunchpad, Mode=TwoWay}" />
                </Grid>
              </Border>
              <Border Style="{StaticResource SDivider}" Visibility="{Binding Settings.DesktopResidentLaunchpad, Converter={StaticResource Bool2Vis}}" />
              <Border Style="{StaticResource SRowItem}" Visibility="{Binding Settings.DesktopResidentLaunchpad, Converter={StaticResource Bool2Vis}}">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
                      <TextBlock Text="触发角临时置顶" Style="{StaticResource STitle}" />
                      <TextBlock Text="鼠标进入所选角落时置顶启动台；离开角落后才能再次触发。" TextWrapping="Wrap" Margin="0,4,0,0" Style="{StaticResource SHint}" />
                    </StackPanel>
                    <ToggleButton Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource MacSwitch}" IsChecked="{Binding Settings.EnableResidentPinHotCorner, Mode=TwoWay}" />
                  </Grid>
                  <Grid Margin="0,10,0,0" Visibility="{Binding Settings.EnableResidentPinHotCorner, Converter={StaticResource Bool2Vis}}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="触发位置" VerticalAlignment="Center" Style="{StaticResource SLabel}" />
                    <ComboBox Grid.Column="1" DisplayMemberPath="Display" SelectedValuePath="Value" Style="{StaticResource SettingsChoice}" ItemsSource="{Binding ResidentPinHotCornerOptions}" SelectedValue="{Binding Settings.ResidentPinHotCorner, Mode=TwoWay}" />
                  </Grid>
                  <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="可与打开启动台共用触发角，不能与 Dock 重复；全屏与游戏暂停规则沿用程序坞设置。" Style="{StaticResource SHint}" Visibility="{Binding Settings.EnableResidentPinHotCorner, Converter={StaticResource Bool2Vis}}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>
      </DataTemplate>
      <DataTemplate x:Key="StartupOpenRow">
        <StackPanel>
          <Border Style="{StaticResource SDivider}" />
          <Border Style="{StaticResource SRowItem}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                <TextBlock Text="自启动后打开启动台" Style="{StaticResource STitle}" />
                <TextBlock Text="关闭时仅在后台运行" Margin="0,4,0,0" Style="{StaticResource SHint}" />
              </StackPanel>
              <ToggleButton Grid.Column="1" Style="{StaticResource MacSwitch}" IsChecked="{Binding Settings.OpenLaunchpadAtStartup, Mode=TwoWay}" />
            </Grid>
          </Border>
        </StackPanel>
      </DataTemplate>
      <DataTemplate x:Key="SolidBackgroundPicker">
        <StackPanel Margin="0,12,0,0">
          <StackPanel Orientation="Horizontal">
            <Button Content="选择颜色…" Style="{StaticResource SheetButton}" Command="{Binding ChooseSolidBackgroundColorCommand}" />
            <Border Width="24" Height="24" CornerRadius="5" BorderThickness="1" BorderBrush="{DynamicResource TextPrimaryBrush}" Margin="12,0,8,0">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type Border}">
                  <Setter Property="Background" Value="{Binding Settings.SolidBackgroundColor}" />
                  <Style.Triggers>
                    <DataTrigger Value="" Binding="{Binding Settings.SolidBackgroundColor}">
                      <Setter Property="Background" Value="{DynamicResource T.Window_FF}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </Border>
            <TextBlock VerticalAlignment="Center" Style="{StaticResource SHint}" Text="{Binding Settings.SolidBackgroundColor}" />
          </StackPanel>
          <TextBlock Text="预设颜色" Margin="0,12,0,6" Style="{StaticResource SHint}" />
          <ItemsControl ItemsSource="{Binding SolidColorPresets}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Margin="0,0,8,8" Padding="8,6" Style="{StaticResource SheetButton}" Command="{Binding DataContext.ApplySolidColorPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Value}" ToolTip="{Binding Value}">
                  <StackPanel Orientation="Horizontal">
                    <Border Width="20" Height="20" CornerRadius="5" BorderBrush="#808080" BorderThickness="1" Margin="0,0,7,0" Background="{Binding Value}" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding Display}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </DataTemplate>
      <ImageBrush x:Key="SheetFrost" Stretch="Fill" ViewboxUnits="Absolute" ViewportUnits="Absolute" />
      <ImageBrush x:Key="FolderFrost" Stretch="Fill" ViewboxUnits="Absolute" ViewportUnits="Absolute" />
      <ItemsPanelTemplate x:Key="AppGridPanelTemplate">
        <UniformGrid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Columns="{Binding Columns}" Rows="{Binding Rows}" />
      </ItemsPanelTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Name="RootGrid" RenderTransformOrigin="0.5, 0.5" Background="#00FFFFFF">
    <FrameworkElement.ContextMenu>
      <ContextMenu Style="{StaticResource MacContextMenuStyle}" Opened="OnBackgroundMenuOpened" Closed="OnBackgroundMenuClosed">
        <MenuItem Header="常驻桌面" Style="{StaticResource MacMenuItemStyle}" IsCheckable="True" InputGestureText="Ctrl + Shift + R" ToolTip="让启动台留在桌面上，打开应用后不会自动收起；默认贴在其他窗口后面，可按 Esc 或选择“收起启动台”暂时隐藏。" IsChecked="{Binding Settings.DesktopResidentLaunchpad, Mode=TwoWay}" />
        <MenuItem Header="置顶启动台" Style="{StaticResource MacMenuItemStyle}" InputGestureText="Ctrl + Shift + T" ToolTip="将启动台显示在其他窗口前面，方便操作；再次切换可贴回桌面。" Visibility="{Binding Settings.DesktopResidentLaunchpad, Converter={StaticResource Bool2Vis}}" Click="OnMenuToggleLaunchpadLayer" />
        <Separator Style="{StaticResource MacMenuSeparatorStyle}" Visibility="{Binding Settings.DesktopResidentLaunchpad, Converter={StaticResource Bool2Vis}}" />
        <MenuItem Header="锁定图标" Style="{StaticResource MacMenuItemStyle}" IsCheckable="True" InputGestureText="Ctrl + Shift + L" ToolTip="禁止拖动图标，避免滑动翻页时误改布局；点击打开应用不受影响，再次切换即可解锁。" IsChecked="{Binding Settings.IconsLocked, Mode=TwoWay}" />
        <MenuItem Header="添加文件夹…" Style="{StaticResource MacMenuItemStyle}" ToolTip="添加文件夹入口，点击后用资源管理器打开；也可以直接拖入文件夹。" Click="OnMenuAddFolder" />
        <MenuItem Header="收纳文件夹（移动）…" Style="{StaticResource MacMenuItemStyle}" ToolTip="将文件夹及其内容移入收纳目录，并添加到启动台；原位置不再保留。" Click="OnMenuStoreFolder" />
        <MenuItem Header="打开文件夹收纳目录" Style="{StaticResource MacMenuItemStyle}" ToolTip="用资源管理器打开收纳目录，查看通过“收纳文件夹”移入的文件夹和文件。" Click="OnMenuOpenFolderStorage" />
        <MenuItem Header="选择文件夹收纳目录…" Style="{StaticResource MacMenuItemStyle}" ToolTip="选择以后收纳文件夹时使用的保存位置。" Click="OnMenuChooseFolderStorage" />
        <MenuItem Header="添加应用…" Style="{StaticResource MacMenuItemStyle}" Click="OnMenuAddApplication">
          <MenuItem.Icon>
            <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M7,0 L7,14 M0,7 L14,7" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="Fluorite 设置…" Style="{StaticResource MacMenuItemStyle}" InputGestureText="Ctrl + ," Click="OnMenuOpenSettings">
          <MenuItem.Icon>
            <Path Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource TextPrimaryBrush}" Data="M12,15.5 A3.5,3.5 0 0 1 8.5,12A3.5,3.5 0 0 1 12,8.5A3.5,3.5 0 0 1 15.5,12A3.5,3.5 0 0 1 12,15.5M19.43,12.97 C19.47,12.65 19.5,12.33 19.5,12 C19.5,11.67 19.47,11.34 19.43,11 L21.54,9.37 C21.73,9.22 21.78,8.95 21.66,8.73 L19.66,5.27 C19.54,5.05 19.27,4.96 19.05,5.05 L16.56,6.08 C16.04,5.66 15.5,5.32 14.87,5.07 L14.5,2.42 C14.46,2.18 14.25,2 14,2 L10,2 C9.75,2 9.54,2.18 9.5,2.42 L9.13,5.07 C8.5,5.32 7.96,5.66 7.44,6.08 L4.95,5.05 C4.73,4.96 4.46,5.05 4.34,5.27 L2.34,8.73 C2.21,8.95 2.27,9.22 2.46,9.37 L4.57,11 C4.53,11.34 4.5,11.67 4.5,12 C4.5,12.33 4.53,12.65 4.57,12.97 L2.46,14.63 C2.27,14.78 2.21,15.05 2.34,15.27 L4.34,18.73 C4.46,18.95 4.73,19.04 4.95,18.95 L7.44,17.92 C7.96,18.34 8.5,18.68 9.13,18.93 L9.5,21.58 C9.54,21.82 9.75,22 10,22 L14,22 C14.25,22 14.46,21.82 14.5,21.58 L14.87,18.93 C15.5,18.68 16.04,18.34 16.56,17.92 L19.05,18.95 C19.27,19.04 19.54,18.95 19.66,18.73 L21.66,15.27 C21.78,15.05 21.73,14.78 21.54,14.63 L19.43,12.97" />
          </MenuItem.Icon>
        </MenuItem>
        <Separator Style="{StaticResource MacMenuSeparatorStyle}" />
        <MenuItem Header="收起启动台" Style="{StaticResource MacMenuItemStyle}" Click="OnMenuCloseLaunchpad">
          <MenuItem.Icon>
            <Path Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource TextPrimaryBrush}" Data="M19,6.41 L17.59,5 L12,10.59 L6.41,5 L5,6.41 L10.59,12 L5,17.59 L6.41,19 L12,13.41 L17.59,19 L19,17.59 L13.41,12 L19,6.41" />
          </MenuItem.Icon>
        </MenuItem>
      </ContextMenu>
    </FrameworkElement.ContextMenu>
    <Image Name="SharpBackdropImage" Stretch="Fill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" RenderOptions.BitmapScalingMode="HighQuality" />
    <Grid Name="BackdropOpacityLayer" Background="{DynamicResource T.Window_FF}">
      <Grid Name="BlurredBackdropGroup">
        <Image Name="BackdropImage" Stretch="Fill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" RenderOptions.BitmapScalingMode="HighQuality" />
        <Border Name="BackdropVeil" Background="{DynamicResource T.Veil}" Opacity="0" />
        <Grid Name="BackdropAmbientOverlay">
          <Border Background="{DynamicResource T.Deep_20}" />
        </Grid>
      </Grid>
    </Grid>
    <Grid Name="SurfaceContent" RenderTransformOrigin="0.5, 0.5" Margin="{Binding ViewportMargin}">
      <UIElement.RenderTransform>
        <TransformGroup>
          <ScaleTransform x:Name="ContentScaleTransform" ScaleX="1.0" ScaleY="1.0" />
          <TranslateTransform x:Name="ContentTranslateTransform" X="0" Y="0" />
        </TransformGroup>
      </UIElement.RenderTransform>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" MinHeight="76" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel Name="TopWidgetsPanel" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Top" MinHeight="38" RenderTransformOrigin="0.5, 0.5">
        <UIElement.RenderTransform>
          <TransformGroup>
            <ScaleTransform x:Name="TopWidgetsScale" ScaleX="1" ScaleY="1" />
            <TranslateTransform x:Name="TopWidgetsShift" Y="0" />
          </TransformGroup>
        </UIElement.RenderTransform>
        <FrameworkElement.Style>
          <Style TargetType="{x:Type StackPanel}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0, 22, 74, 0" />
            <Setter Property="Visibility" Value="{Binding Settings.ShowTopWidgets, Converter={StaticResource Bool2Vis}}" />
            <Style.Triggers>
              <DataTrigger Value="Left" Binding="{Binding Settings.TopWidgetsPosition}">
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Margin" Value="28, 22, 0, 0" />
              </DataTrigger>
              <DataTrigger Value="Center" Binding="{Binding Settings.TopWidgetsPosition}">
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0, 22, 0, 0" />
              </DataTrigger>
              <DataTrigger Value="Right" Binding="{Binding Settings.TopWidgetsPosition}">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="Margin" Value="0, 22, 74, 0" />
              </DataTrigger>
              <DataTrigger Value="False" Binding="{Binding Settings.ShowTopWidgets}">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
        <ContentControl ContentTemplate="{StaticResource TopClockCapsuleContent}" Content="{Binding}">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type ContentControl}">
              <Setter Property="Visibility" Value="{Binding Settings.ShowTopClock, Converter={StaticResource Bool2Vis}}" />
              <Style.Triggers>
                <DataTrigger Value="True" Binding="{Binding Settings.ClockLargeMode}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </ContentControl>
        <Border CornerRadius="14" BorderBrush="{DynamicResource T.SearchBorder}" BorderThickness="1" Padding="13,0,13,0" Margin="8,0,0,0" Height="38" Cursor="Hand" ToolTip="系统资源监控 (点击打开任务管理器)" Visibility="{Binding Settings.ShowTopSystemMonitor, Converter={StaticResource Bool2Vis}}">
          <Border.Background>
            <SolidColorBrush Color="{DynamicResource T.Pill2_8Ac}" />
          </Border.Background>
          <FrameworkElement.Style>
            <Style TargetType="{x:Type Border}">
              <Setter Property="UIElement.RenderTransformOrigin" Value="0.5, 0.5" />
              <Setter Property="RenderTransform">
                <Setter.Value>
                  <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
              </Setter>
              <Style.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <TriggerBase.EnterActions>
                    <BeginStoryboard>
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.03" Duration="0:0:0.18" />
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.03" Duration="0:0:0.18" />
                      </Storyboard>
                    </BeginStoryboard>
                  </TriggerBase.EnterActions>
                  <TriggerBase.ExitActions>
                    <BeginStoryboard>
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.18" />
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.18" />
                      </Storyboard>
                    </BeginStoryboard>
                  </TriggerBase.ExitActions>
                </Trigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
          <UIElement.InputBindings>
            <MouseBinding Gesture="LeftClick" Command="{Binding OpenTaskManagerCommand}" />
          </UIElement.InputBindings>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Path Width="12.5" Height="12.5" Stretch="Uniform" Fill="{DynamicResource T.Fg_80}" Margin="0,0,5,0" Data="M17,17 L7,17 L7,7 L17,7 M21,11 L21,9 L19,9 L19,7 C19,5.89 18.1,5 17,5 L15,5 L15,3 L13,3 L13,5 L11,5 L11,3 L9,3 L9,5 L7,5 C5.89,5 5,5.89 5,7 L5,9 L3,9 L3,11 L5,11 L5,13 L3,13 L3,15 L5,15 L5,17 A2,2 0 0 0 7,19L9,19 L9,21 L11,21 L11,19 L13,19 L13,21 L15,21 L15,19 L17,19 A2,2 0 0 0 19,17L19,15 L21,15 L21,13 L19,13 L19,11 M15,9 L9,9 L9,15 L15,15 L15,9" />
            <TextBlock Text="CPU" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource T.Fg_80}" VerticalAlignment="Center" />
            <TextBlock Width="34" TextAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource T.Fg_FF}" Text="{Binding CpuUsage, StringFormat='{}{0:0}%'}" />
            <Border Width="1" Height="11" Background="{DynamicResource T.Fg_1A}" Margin="9,0" VerticalAlignment="Center" />
            <Path Width="12.5" Height="12.5" Stretch="Uniform" Fill="{DynamicResource T.Fg_80}" Margin="0,0,5,0" Data="M2,7 L2,9 L4,9 L4,15 L2,15 L2,17 L5,17 L5,19 L7,19 L7,17 L9,17 L9,19 L11,19 L11,17 L13,17 L13,19 L15,19 L15,17 L17,17 L17,19 L19,19 L19,17 L22,17 L22,15 L20,15 L20,9 L22,9 L22,7 L19,7 L19,5 L17,5 L17,7 L15,7 L15,5 L13,5 L13,7 L11,7 L11,5 L9,5 L9,7 L7,7 L7,5 L5,5 L5,7 L2,7 M6,9 L18,9 L18,15 L6,15 L6,9" />
            <TextBlock Text="RAM" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource T.Fg_80}" />
            <TextBlock Width="34" TextAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource T.Fg_FF}" Text="{Binding MemoryUsage, StringFormat='{}{0:0}%'}" />
          </StackPanel>
        </Border>
      </StackPanel>
      <StackPanel Name="SearchPanel" Grid.Row="0" ZIndex="60" RenderTransformOrigin="0.5, 0.5">
        <UIElement.RenderTransform>
          <TranslateTransform x:Name="SearchPanelShift" Y="0" />
        </UIElement.RenderTransform>
        <FrameworkElement.Style>
          <Style TargetType="{x:Type StackPanel}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0, 22, 0, 16" />
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
              <DataTrigger Value="Left" Binding="{Binding Settings.SearchPosition}">
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Margin" Value="28, 22, 0, 16" />
              </DataTrigger>
              <DataTrigger Value="Center" Binding="{Binding Settings.SearchPosition}">
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0, 22, 0, 16" />
              </DataTrigger>
              <DataTrigger Value="Right" Binding="{Binding Settings.SearchPosition}">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="Margin" Value="0, 22, 74, 16" />
              </DataTrigger>
              <DataTrigger Value="AlwaysHidden" Binding="{Binding Settings.SearchDisplayMode}">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Value="AlwaysHidden" Binding="{Binding Settings.SearchDisplayMode}" />
                  <Condition Value="True" Binding="{Binding IsSearchRevealedByHover}" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible" />
              </MultiDataTrigger>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Value="AlwaysHidden" Binding="{Binding Settings.SearchDisplayMode}" />
                  <Condition Value="True" Binding="{Binding IsSearchActive}" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible" />
              </MultiDataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
        <Grid Name="SearchFieldHost" Width="400" Height="38">
          <TextBox Name="SearchBox" Style="{StaticResource SearchTextBoxStyle}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
          <Border Name="HotkeyCapsule" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0" Padding="8,3,8,4" CornerRadius="7" Background="{DynamicResource T.Fl_0A}" RenderTransformOrigin="0.5, 0.5" IsHitTestVisible="False">
            <UIElement.RenderTransform>
              <ScaleTransform x:Name="HotkeyScale" ScaleX="1" ScaleY="1" />
            </UIElement.RenderTransform>
            <FrameworkElement.Style>
              <Style TargetType="{x:Type Border}">
                <Style.Triggers>
                  <DataTrigger Value="True" Binding="{Binding IsSearchActive}">
                    <TriggerBase.EnterActions>
                      <BeginStoryboard>
                        <Storyboard>
