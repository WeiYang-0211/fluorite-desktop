                              <Button Grid.Column="1" Style="{StaticResource SheetButton}" Content="激活" Height="34" Padding="18,0" Margin="10,0,0,0" VerticalAlignment="Center" Command="{Binding ActivateCommand}" />
                            </Grid>
                            <TextBlock Text="支持换机 · 在新电脑输入同一个激活码即可自动迁移设备授权" Style="{StaticResource SHint}" Margin="0,8,0,0" />
                          </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SGroup}" Margin="0,0,0,12">
                          <StackPanel>
                            <Border Style="{StaticResource SRowItem}">
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="分享邀请码" Style="{StaticResource STitle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Border Background="{DynamicResource T.PresetCard}" BorderBrush="{DynamicResource T.Fg_14}" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                      <TextBlock FontFamily="Consolas, Segoe UI" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource T.AccText_FF}" VerticalAlignment="Center" Text="{Binding InviteCodeText, Mode=OneWay}" />
                                    </Border>
                                  </StackPanel>
                                  <TextBlock Style="{StaticResource SHint}" Margin="0,3,0,0" Text="{Binding InviteSummaryText}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="复制邀请码" Style="{StaticResource SheetButton}" VerticalAlignment="Center" Command="{Binding CopyInviteCodeCommand}" />
                              </Grid>
                            </Border>
                            <Border Style="{StaticResource SDivider}" />
                            <Border Style="{StaticResource SRowItem}">
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                  <TextBlock Text="兑换朋友的邀请码" Style="{StaticResource STitle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                  <TextBlock Text="每台设备仅可兑换一次，成功后双方领取体验天数" Style="{StaticResource SHint}" Margin="0,3,0,0" Visibility="{Binding HasRedeemedInvite, Converter={StaticResource InvBool2Vis}}" />
                                  <TextBlock Text="已兑换成功，无法再次兑换或更换邀请码" Style="{StaticResource SHint}" Margin="0,3,0,0" Visibility="{Binding HasRedeemedInvite, Converter={StaticResource Bool2Vis}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding HasRedeemedInvite, Converter={StaticResource InvBool2Vis}}">
                                  <Grid Width="170">
                                    <TextBox Name="InviteCodeInput" Style="{StaticResource SInput}" Height="32" FontFamily="Consolas, Segoe UI" FontSize="12.5" Padding="10,0" VerticalContentAlignment="Center" MaxLength="24" InputMethod.IsInputMethodEnabled="False" AutomationProperties.Name="朋友的邀请码" Text="{Binding InviteInput, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                    <TextBlock Text="朋友的邀请码" VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False">
                                      <FrameworkElement.Style>
                                        <Style BasedOn="{StaticResource SHint}" TargetType="{x:Type TextBlock}">
                                          <Setter Property="Visibility" Value="Collapsed" />
                                          <Style.Triggers>
                                            <MultiDataTrigger>
                                              <MultiDataTrigger.Conditions>
                                                <Condition Value="" Binding="{Binding InviteInput}" />
                                                <Condition Value="False" Binding="{Binding IsKeyboardFocusWithin, ElementName=InviteCodeInput}" />
                                              </MultiDataTrigger.Conditions>
                                              <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                          </Style.Triggers>
                                        </Style>
                                      </FrameworkElement.Style>
                                    </TextBlock>
                                  </Grid>
                                  <Button Content="兑换" Style="{StaticResource SheetButton}" Height="32" Padding="14,0" Margin="8,0,0,0" VerticalAlignment="Center" Command="{Binding RedeemInviteCommand}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="已兑换" Foreground="{DynamicResource SheetAccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Visibility="{Binding HasRedeemedInvite, Converter={StaticResource Bool2Vis}}" />
                              </Grid>
                            </Border>
                          </StackPanel>
                        </Border>
                        <ContentControl ContentTemplate="{StaticResource ProBackupTools}" Content="{Binding}" />
                        <Border Style="{StaticResource SGroup}" Padding="16,14" Margin="0,12,0,0">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                              <TextBlock Text="反馈与建议" Style="{StaticResource STitle}" />
                              <TextBlock Text="反馈建议，有机会获得 Pro 权限" Style="{StaticResource SHint}" Margin="0,5,12,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="xujtao@foxmail.com" Style="{StaticResource WorkspaceButton}" ToolTip="点击复制反馈邮箱" VerticalAlignment="Center" FontSize="12" Command="{Binding CopyFeedbackEmailCommand}" />
                          </Grid>
                        </Border>
                      </StackPanel>
                    </StackPanel>
                    <ContentControl ContentTemplate="{StaticResource AtmosphereSettings}" Content="{Binding}">
                      <FrameworkElement.Style>
                        <Style TargetType="{x:Type ContentControl}">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Value="外观" Binding="{Binding ActiveSection}">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Value="外观与图标" Binding="{Binding ActiveSection}">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Value="动效与手势" Binding="{Binding ActiveSection}">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </FrameworkElement.Style>
                    </ContentControl>
                  </StackPanel>
                </ScrollViewer>
              </Grid>
            </Grid>
          </Grid>
        </Border>
      </Grid>
    </Grid>
    <Border Panel.ZIndex="90" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="16,0,16,70" Padding="16,9" CornerRadius="10" Background="{DynamicResource T.Fl_20}" IsHitTestVisible="False">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type Border}">
          <Setter Property="Visibility" Value="Visible" />
          <Style.Triggers>
            <DataTrigger Value="" Binding="{Binding ManualAddFeedback}">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
      <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Text="{Binding ManualAddFeedback}" />
    </Border>
    <Border Panel.ZIndex="95" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24,0,24,130" Padding="18,10" CornerRadius="12" Background="{DynamicResource T.Chip_F2}" BorderBrush="{DynamicResource T.Fg_14}" BorderThickness="1" IsHitTestVisible="False" MaxWidth="420">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type Border}">
          <Setter Property="Visibility" Value="Visible" />
          <Style.Triggers>
            <DataTrigger Value="" Binding="{Binding SceneSwitchFeedback}">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
      <TextBlock Foreground="{DynamicResource SheetTextBrush}" FontSize="13" TextTrimming="CharacterEllipsis" Text="{Binding SceneSwitchFeedback}" />
    </Border>
    <Canvas Name="DragCanvas" ZIndex="200" IsHitTestVisible="False">
      <Grid Name="FoldHighlight" Visibility="Collapsed" Width="0" Height="0" RenderTransformOrigin="0.5, 0.5">
        <UIElement.RenderTransform>
          <ScaleTransform x:Name="FoldHighlightScale" />
        </UIElement.RenderTransform>
        <Border CornerRadius="18" BorderThickness="1.5" BorderBrush="{DynamicResource T.Fg_7A}">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="{DynamicResource T.Gl_24c}" Offset="0" />
              <GradientStop Color="{DynamicResource T.Gl_0Dc}" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
          <UIElement.Effect>
            <DropShadowEffect Color="{DynamicResource T.Gl_FFc}" BlurRadius="20" ShadowDepth="0" Opacity="0.28" />
          </UIElement.Effect>
        </Border>
      </Grid>
      <StackPanel Name="FoldHint" Visibility="Collapsed">
        <UIElement.RenderTransform>
          <TranslateTransform x:Name="FoldHintShift" />
        </UIElement.RenderTransform>
        <Border CornerRadius="10" Padding="9,5" Background="{DynamicResource T.Chip_F2}" BorderBrush="{DynamicResource T.Fg_2E}" BorderThickness="1">
          <UIElement.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.5" />
          </UIElement.Effect>
          <StackPanel Orientation="Horizontal">
            <Border Name="FoldHintBadge" Width="15" Height="15" CornerRadius="8" Background="{DynamicResource T.Acc_FF}" VerticalAlignment="Center">
              <Path Name="FoldHintGlyph" Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" Fill="{DynamicResource T.OnAcc}" Data="M10.6,4.6 L13.4,4.6 L13.4,10.6 L19.4,10.6 L19.4,13.4 L13.4,13.4 L13.4,19.4 L10.6,19.4 L10.6,13.4 L4.6,13.4 L4.6,10.6 L10.6,10.6" />
            </Border>
            <TextBlock Name="FoldHintText" Margin="7,0,1,0" Foreground="{DynamicResource T.Fg_F2}" FontSize="12" />
          </StackPanel>
        </Border>
        <Path Name="FoldHintArrow" Width="14" Height="7" HorizontalAlignment="Center" Stretch="Fill" Fill="{DynamicResource T.Chip_F2}" Data="M0,0 L7,7 L14,0" />
      </StackPanel>
      <Border Name="FloatingDragCard" Visibility="Collapsed" RenderTransformOrigin="0.5, 0.5">
        <UIElement.RenderTransform>
          <ScaleTransform x:Name="FloatingDragScale" ScaleX="1.1" ScaleY="1.1" />
        </UIElement.RenderTransform>
        <UIElement.Effect>
          <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="10" Opacity="0.55" />
        </UIElement.Effect>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <Image Name="FloatingDragImage" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform" HorizontalAlignment="Center" />
          <TextBlock Name="FloatingDragLabel" Margin="0, 8, 0, 0" Foreground="{DynamicResource T.Fg_FF}" FontSize="12" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Border>
      <Border Name="ExternalDragGhost" Visibility="Collapsed" IsHitTestVisible="False" Background="{DynamicResource T.Chip_F2}" BorderBrush="{DynamicResource T.Fg_2E}" BorderThickness="1" CornerRadius="12" Padding="10,6,12,6" RenderTransformOrigin="0,0">
        <UIElement.Effect>
          <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="6" Opacity="0.5" />
        </UIElement.Effect>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Grid Width="34" Height="34" Margin="0,0,10,0">
            <Border CornerRadius="7" Background="{DynamicResource T.Deep_20}" BorderBrush="{DynamicResource T.Fg_14}" BorderThickness="0.8" />
            <Image Name="ExternalDragIcon" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform" />
            <Border Name="ExternalDragBadge" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0" Background="{DynamicResource T.Acc_FF}" CornerRadius="6" MinWidth="15" Height="15" Padding="3,0,3,0">
              <TextBlock Name="ExternalDragBadgeText" Foreground="#FFFFFF" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" />
            </Border>
          </Grid>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Name="ExternalDragFileName" Foreground="{DynamicResource T.Fg_FF}" FontSize="12" FontWeight="SemiBold" MaxWidth="160" TextTrimming="CharacterEllipsis" />
            <TextBlock Name="ExternalDragHint" Margin="0,1.5,0,0" Foreground="{DynamicResource T.Fg_80}" FontSize="10.5" Text="拖入应用以打开" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Canvas>
  </Grid>
</Window>