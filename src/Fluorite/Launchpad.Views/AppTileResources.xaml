  <DataTemplate x:Key="ClockIconContent">
    <Viewbox Stretch="Uniform">
      <Grid Width="112" Height="112" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
        <Border CornerRadius="23" BorderThickness="1">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type Border}">
              <Setter Property="Background" Value="{DynamicResource T.Chip_F2}" />
              <Setter Property="BorderBrush" Value="{DynamicResource T.Fg_1A}" />
              <Style.Triggers>
                <DataTrigger Value="{x:Static models:ClockStyle.Digital}" Binding="{Binding DataContext.Settings.ClockStyle, RelativeSource={RelativeSource AncestorType=Window}}">
                  <Setter Property="Background" Value="#172725" />
                  <Setter Property="BorderBrush" Value="#334B46" />
                </DataTrigger>
                <DataTrigger Value="{x:Static models:ClockStyle.Elegant}" Binding="{Binding DataContext.Settings.ClockStyle, RelativeSource={RelativeSource AncestorType=Window}}">
                  <Setter Property="Background" Value="#F3EBDD" />
                  <Setter Property="BorderBrush" Value="#D9C8AD" />
                </DataTrigger>
                <DataTrigger Value="{x:Static models:ClockStyle.Vibrant}" Binding="{Binding DataContext.Settings.ClockStyle, RelativeSource={RelativeSource AncestorType=Window}}">
                  <Setter Property="Background">
                    <Setter.Value>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#625789" Offset="0" />
                        <GradientStop Color="#354C73" Offset="0.65" />
                        <GradientStop Color="#254B58" Offset="1" />
                      </LinearGradientBrush>
                    </Setter.Value>
                  </Setter>
                  <Setter Property="BorderBrush" Value="#607F8EA9" />
                </DataTrigger>
                <DataTrigger Value="True" Binding="{Binding DataContext.Settings.ClockTransparentBackground, RelativeSource={RelativeSource AncestorType=Window}}">
                  <Setter Property="Background" Value="#00FFFFFF" />
                  <Setter Property="BorderBrush" Value="#00FFFFFF" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
          <ContentControl HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Content="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type ContentControl}">
                <Setter Property="ContentTemplate" Value="{StaticResource ClockFaceClassic}" />
                <Style.Triggers>
                  <DataTrigger Value="{x:Static models:ClockStyle.Minimal}" Binding="{Binding DataContext.Settings.ClockStyle, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Setter Property="ContentTemplate" Value="{StaticResource ClockFaceMinimal}" />
                  </DataTrigger>
                  <DataTrigger Value="{x:Static models:ClockStyle.Digital}" Binding="{Binding DataContext.Settings.ClockStyle, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Setter Property="ContentTemplate" Value="{StaticResource ClockFaceDigital}" />
                  </DataTrigger>
                  <DataTrigger Value="{x:Static models:ClockStyle.Elegant}" Binding="{Binding DataContext.Settings.ClockStyle, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Setter Property="ContentTemplate" Value="{StaticResource ClockFaceElegant}" />
                  </DataTrigger>
                  <DataTrigger Value="{x:Static models:ClockStyle.Vibrant}" Binding="{Binding DataContext.Settings.ClockStyle, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Setter Property="ContentTemplate" Value="{StaticResource ClockFaceVibrant}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </ContentControl>
        </Border>
      </Grid>
    </Viewbox>
  </DataTemplate>
  <DataTemplate x:Key="SystemMonitorIconContent">
