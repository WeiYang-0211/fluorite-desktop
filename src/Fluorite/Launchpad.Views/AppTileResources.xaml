            <Setter Property="Foreground" Value="{DynamicResource T.Fg_80}" />
            <Style.Triggers>
              <DataTrigger Value="True" Binding="{Binding Settings.ClockTransparentBackground}">
                <Setter Property="Foreground" Value="{DynamicResource T.Fg_FF}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
