                <Condition Value="False" Binding="{Binding DataContext.IsItemDragActive, RelativeSource={RelativeSource AncestorType=Window}}" />
              </MultiDataTrigger.Conditions>
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="0.93" Duration="0:0:0.09">
                      <DoubleAnimation.EasingFunction>
                        <infra:SpringEase Bounce="0.22" />
