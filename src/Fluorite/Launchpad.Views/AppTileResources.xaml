            <DataTrigger Value="{x:Static models:ClockStyle.Elegant}" Binding="{Binding Settings.ClockStyle}">
              <Setter Property="BorderBrush" Value="#40FFD59E" />
            </DataTrigger>
            <DataTrigger Value="{x:Static models:ClockStyle.Vibrant}" Binding="{Binding Settings.ClockStyle}">
              <Setter Property="BorderBrush" Value="#506F608E" />
            </DataTrigger>
            <DataTrigger Value="True" Binding="{Binding Settings.ClockTransparentBackground}">
