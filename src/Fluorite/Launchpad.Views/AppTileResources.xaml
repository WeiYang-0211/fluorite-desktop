<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary x:Class="Launchpad.Views.AppTileResources" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="clr-namespace:Launchpad.Models" xmlns:infra="clr-namespace:Launchpad.Infrastructure" xmlns:views="clr-namespace:Launchpad.Views">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Fluorite;component/Resources/Styles.xaml" />
    <ResourceDictionary Source="/Fluorite;component/Resources/SettingsStyles.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <infra:LabelShadowConverter x:Key="LabelShadow" />
  <Style x:Key="NameChipToolTipStyle" TargetType="{x:Type ToolTip}">
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="ToolTip.Placement" Value="Top" />
    <Setter Property="ToolTip.VerticalOffset" Value="6" />
    <Setter Property="ToolTip.HasDropShadow" Value="False" />
    <Setter Property="Background" Value="{DynamicResource T.Chip_F2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.Fg_26}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,4,10,5" />
    <Setter Property="MaxWidth" Value="360" />
    <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToolTip}">
          <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="8">
            <ContentPresenter Margin="{TemplateBinding Control.Padding}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <DataTemplate x:Key="AppIconContent">
    <Grid>
      <Image RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform" Margin="1" Source="{Binding Icon}">
        <FrameworkElement.Style>
          <Style TargetType="{x:Type Image}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Value="{x:Static models:IconShape.Original}" Binding="{Binding DataContext.Settings.IconShape, RelativeSource={RelativeSource AncestorType=Window}}">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </Image>
      <Border SnapsToDevicePixels="False" UseLayoutRounding="True" RenderOptions.BitmapScalingMode="HighQuality" RenderOptions.EdgeMode="Unspecified" BorderThickness="0.8" BorderBrush="{DynamicResource T.Fg_14}" CornerRadius="{Binding DataContext.IconCornerRadius, RelativeSource={RelativeSource AncestorType=Window}}">
        <FrameworkElement.Style>
          <Style TargetType="{x:Type Border}">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
              <DataTrigger Value="{x:Static models:IconShape.Original}" Binding="{Binding DataContext.Settings.IconShape, RelativeSource={RelativeSource AncestorType=Window}}">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
        <Border.Background>
          <ImageBrush Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" RenderOptions.BitmapScalingMode="HighQuality" RenderOptions.EdgeMode="Unspecified" ImageSource="{Binding Icon}" />
        </Border.Background>
      </Border>
      <Path Name="PlaceholderIcon" HorizontalAlignment="Center" VerticalAlignment="Center" Width="32" Height="32" Stretch="Uniform" Fill="{DynamicResource T.Fg_80}" Data="M4,2 L20,2 A2,2 0 0 1 22,4L22,16 A2,2 0 0 1 20,18L16,18 L12,22 L8,18 L4,18 A2,2 0 0 1 2,16L2,4 A2,2 0 0 1 4,2M4,4 L4,16 L8.83,16 L12,19.17 L15.17,16 L20,16 L20,4 L4,4">
        <FrameworkElement.Style>
          <Style TargetType="{x:Type Path}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </Path>
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="FolderIconContent">
    <Grid>
      <Border BorderThickness="1" Padding="6.5" ClipToBounds="False" CornerRadius="{Binding DataContext.FolderCornerRadius, RelativeSource={RelativeSource AncestorType=Window}}">
        <Border.BorderBrush>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#60FFFFFF" Offset="0.0" />
            <GradientStop Color="#24FFFFFF" Offset="0.45" />
            <GradientStop Color="#10FFFFFF" Offset="1.0" />
          </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#3DFFFFFF" Offset="0.0" />
            <GradientStop Color="#20FFFFFF" Offset="0.4" />
            <GradientStop Color="#12FFFFFF" Offset="1.0" />
          </LinearGradientBrush>
        </Border.Background>
        <UIElement.Effect>
          <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="2.5" Direction="270" Opacity="0.32" />
        </UIElement.Effect>
        <Grid>
          <Border IsHitTestVisible="False" CornerRadius="{Binding DataContext.FolderCornerRadius, RelativeSource={RelativeSource AncestorType=Window}}">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#20FFFFFF" Offset="0.0" />
                <GradientStop Color="#06FFFFFF" Offset="0.3" />
                <GradientStop Color="#00000000" Offset="0.6" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>
          <ItemsControl HorizontalAlignment="Center" VerticalAlignment="Center" ItemsSource="{Binding PreviewChildren}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="{Binding PreviewGridSize}" Rows="{Binding PreviewGridSize}" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:Key="{DataTemplateKey {x:Type models:AppItem}}" DataType="{x:Type models:AppItem}">
                <Border Margin="2" CornerRadius="5" ClipToBounds="True">
                  <UIElement.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="3" ShadowDepth="1" Direction="270" Opacity="0.22" />
                  </UIElement.Effect>
                  <Image RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform" Source="{Binding Icon}" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>
    </Grid>
  </DataTemplate>
