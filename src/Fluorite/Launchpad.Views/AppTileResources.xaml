          <Border Width="1" Height="11" Background="{DynamicResource T.Fg_1A}" Margin="8,0" VerticalAlignment="Center" />
          <views:ClockTextBlock Foreground="{DynamicResource T.Fg_80}" VerticalAlignment="Center" views:ClockInk.Color="{Binding Settings.ClockTextColor}" Text="{Binding ClockDate}" FontSize="{Binding Settings.TopClockDateFontSize}" />
          <views:ClockTextBlock Foreground="{DynamicResource T.Fg_80}" VerticalAlignment="Center" Margin="5,0,0,0" views:ClockInk.Color="{Binding Settings.ClockTextColor}" Text="{Binding ClockDayOfWeek}" FontSize="{Binding Settings.TopClockDateFontSize}" />
        </StackPanel>
      </Grid>
