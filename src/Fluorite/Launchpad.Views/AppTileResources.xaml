          <views:ClockTextBlock FontFamily="Consolas, Cascadia Code, Courier New" FontWeight="SemiBold" Foreground="#8CA99B" VerticalAlignment="Center" Margin="1,1,0,0" views:ClockInk.Color="{Binding Settings.ClockTextColor}" Text="{Binding ClockSeconds, StringFormat=:{0}}" FontSize="{Binding Settings.TopClockFontSize}" Visibility="{Binding Settings.ClockShowSeconds, Converter={StaticResource Bool2Vis}}" />
          <Border Width="1" Height="11" Background="#30477966" Margin="8,0" VerticalAlignment="Center" />
          <views:ClockTextBlock FontFamily="Consolas, Cascadia Code" Foreground="{DynamicResource T.Fg_80}" VerticalAlignment="Center" views:ClockInk.Color="{Binding Settings.ClockTextColor}" Text="{Binding ClockDate}" FontSize="{Binding Settings.TopClockDateFontSize}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type StackPanel}">
              <Setter Property="Visibility" Value="Collapsed" />
