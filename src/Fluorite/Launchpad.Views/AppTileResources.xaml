          <views:ClockTextBlock Foreground="{DynamicResource T.Fg_80}" VerticalAlignment="Center" Margin="1,1,0,0" views:ClockInk.Color="{Binding Settings.ClockTextColor}" Text="{Binding ClockSeconds, StringFormat=:{0}}" FontSize="{Binding Settings.TopClockFontSize}" Visibility="{Binding Settings.ClockShowSeconds, Converter={StaticResource Bool2Vis}}" />
          <views:ClockTextBlock Text=" · " Foreground="{DynamicResource T.Fg_80}" VerticalAlignment="Center" Margin="4,0" views:ClockInk.Color="{Binding Settings.ClockTextColor}" FontSize="{Binding Settings.TopClockDateFontSize}" />
          <views:ClockTextBlock Foreground="{DynamicResource T.Fg_80}" VerticalAlignment="Center" views:ClockInk.Color="{Binding Settings.ClockTextColor}" Text="{Binding ClockDayOfWeek}" FontSize="{Binding Settings.TopClockDateFontSize}" />
        </StackPanel>
