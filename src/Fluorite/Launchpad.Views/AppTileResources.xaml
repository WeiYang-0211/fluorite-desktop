          <views:ClockTextBlock Opacity="0.65" VerticalAlignment="Bottom" Margin="3,0,0,7" views:ClockInk.Color="{Binding Settings.ClockTextColor}" Text="{Binding ClockSeconds}" FontSize="{Binding Settings.ClockSecondsFontSize}" Visibility="{Binding Settings.ClockShowSeconds, Converter={StaticResource Bool2Vis}}">
