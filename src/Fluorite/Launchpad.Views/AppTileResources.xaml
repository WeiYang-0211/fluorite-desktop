              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
          <views:ClockTextBlock FontFamily="Georgia, Times New Roman" FontWeight="Normal" Foreground="{DynamicResource T.Fg_FF}" VerticalAlignment="Center" views:ClockInk.Color="{Binding Settings.ClockTextColor}" Text="{Binding ClockTime}" FontSize="{Binding Settings.TopClockFontSize}" />
          <views:ClockTextBlock FontFamily="Georgia" Foreground="{DynamicResource T.Fg_80}" VerticalAlignment="Center" Margin="1,1,0,0" views:ClockInk.Color="{Binding Settings.ClockTextColor}" Text="{Binding ClockSeconds, StringFormat=:{0}}" FontSize="{Binding Settings.TopClockFontSize}" Visibility="{Binding Settings.ClockShowSeconds, Converter={StaticResource Bool2Vis}}" />
          <Border Width="1" Height="11" Background="#30FFD59E" Margin="8,0" VerticalAlignment="Center" />
          <views:ClockTextBlock Foreground="{DynamicResource T.AccText_FF}" VerticalAlignment="Center" views:ClockInk.Color="{Binding Settings.ClockTextColor}" Text="{Binding ClockLunar}" FontSize="{Binding Settings.TopClockDateFontSize}" />
          <views:ClockTextBlock Foreground="{DynamicResource T.Fg_80}" VerticalAlignment="Center" Margin="6,0,0,0" views:ClockInk.Color="{Binding Settings.ClockTextColor}" Text="{Binding ClockDayOfWeek}" FontSize="{Binding Settings.TopClockDateFontSize}" />
        </StackPanel>
