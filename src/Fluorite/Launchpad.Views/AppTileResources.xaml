          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <views:ClockTextBlock FontWeight="SemiBold" Foreground="{DynamicResource T.Fg_FF}" VerticalAlignment="Center" views:ClockInk.Color="{Binding Settings.ClockTextColor}" Text="{Binding ClockTime}" FontSize="{Binding Settings.TopClockFontSize}" />
            <views:ClockTextBlock Foreground="{DynamicResource T.Fg_80}" VerticalAlignment="Center" Margin="1,1,0,0" views:ClockInk.Color="{Binding Settings.ClockTextColor}" Text="{Binding ClockSeconds, StringFormat=:{0}}" FontSize="{Binding Settings.TopClockFontSize}" Visibility="{Binding Settings.ClockShowSeconds, Converter={StaticResource Bool2Vis}}" />
          </StackPanel>
          <Border Width="1" Height="11" Background="{DynamicResource T.Fg_1A}" Margin="8,0" VerticalAlignment="Center" />
          <views:ClockTextBlock Foreground="{DynamicResource T.Fg_80}" VerticalAlignment="Center" views:ClockInk.Color="{Binding Settings.ClockTextColor}" Text="{Binding ClockDate}" FontSize="{Binding Settings.TopClockDateFontSize}" />
          <views:ClockTextBlock Foreground="{DynamicResource T.Fg_80}" VerticalAlignment="Center" Margin="5,0,0,0" views:ClockInk.Color="{Binding Settings.ClockTextColor}" Text="{Binding ClockDayOfWeek}" FontSize="{Binding Settings.TopClockDateFontSize}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
