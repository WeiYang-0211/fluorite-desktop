<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:infra="clr-namespace:Launchpad.Infrastructure">
  <FontFamily x:Key="AppFont">pack://application:,,,/Assets/Fonts/#PingFang SC, PingFang SC, 苹方, 苹方-简, Segoe UI Variable Text, Microsoft YaHei UI, sans-serif</FontFamily>
  <Style x:Key="DialogScrollBar" TargetType="{x:Type ScrollBar}">
    <Setter Property="Width" Value="8" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ScrollBar}">
          <Track Name="PART_Track" IsDirectionReversed="True">
            <Track.DecreaseRepeatButton>
              <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
            </Track.DecreaseRepeatButton>
            <Track.Thumb>
              <Thumb>
                <Control.Template>
                  <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border Background="{DynamicResource T.Fg_28}" CornerRadius="3" Margin="2,0" />
                  </ControlTemplate>
                </Control.Template>
              </Thumb>
            </Track.Thumb>
            <Track.IncreaseRepeatButton>
              <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
            </Track.IncreaseRepeatButton>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SearchTextBoxStyle" TargetType="{x:Type TextBox}">
    <Setter Property="Foreground" Value="{DynamicResource T.Fg_F2}" />
    <Setter Property="TextBoxBase.CaretBrush" Value="{DynamicResource T.Fg_FF}" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TextBox}">
          <Grid>
            <Border Name="Bd" CornerRadius="14" BorderThickness="{TemplateBinding Control.BorderThickness}" BorderBrush="{DynamicResource T.SearchBorder}">
              <Border.Background>
                <SolidColorBrush Color="{DynamicResource T.Pill2_8Ac}" />
              </Border.Background>
              <Grid>
                <Border Name="HoverLift" CornerRadius="13" Background="{DynamicResource T.Fl_10}" Opacity="0" IsHitTestVisible="False" />
                <Border Name="FocusFill" CornerRadius="13" Background="{DynamicResource T.SearchFocusFill}" Opacity="0" IsHitTestVisible="False" />
                <Grid Name="Lens" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="13,0,0,0" Width="15" Height="15" Opacity="0.5" IsHitTestVisible="False">
                  <Ellipse Width="9.5" Height="9.5" Stroke="{DynamicResource T.NearWhite_EA}" StrokeThickness="1.35" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1,1,0,0" />
                  <Path Stroke="{DynamicResource T.NearWhite_EA}" StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M9.3,9.3 L13.2,13.2" />
                </Grid>
                <TextBlock Name="PlaceholderText" Text="搜索应用名称或拼音首字母" Foreground="{DynamicResource T.Fg_8A}" FontSize="{TemplateBinding Control.FontSize}" FontFamily="{TemplateBinding Control.FontFamily}" VerticalAlignment="Center" Margin="37,0,0,0" Opacity="0" IsHitTestVisible="False" />
                <ScrollViewer Name="PART_ContentHost" VerticalAlignment="Center" Margin="37,0,74,0" />
              </Grid>
            </Border>
            <Border Name="EdgeLight" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource T.SearchBorderHover}" Opacity="0" IsHitTestVisible="False" />
            <Border Name="FocusEdge" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource T.SearchBorderFocus}" Opacity="0" IsHitTestVisible="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="PlaceholderText" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="PlaceholderText" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.13" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="UIElement.IsMouseOver" Value="True" />
                <Condition Property="UIElement.IsKeyboardFocused" Value="False" />
              </MultiTrigger.Conditions>
              <TriggerBase.EnterActions>
                <BeginStoryboard Name="PillLift">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverLift" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                    <DoubleAnimation Storyboard.TargetName="EdgeLight" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.20">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverLift" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.20" />
                    <DoubleAnimation Storyboard.TargetName="EdgeLight" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.28" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </MultiTrigger>
            <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
              <TriggerBase.EnterActions>
                <BeginStoryboard Name="PillFocus">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="FocusEdge" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="FocusFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
                    <DoubleAnimation Storyboard.TargetName="Lens" Storyboard.TargetProperty="Opacity" To="0.8" Duration="0:0:0.18" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="FocusEdge" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.24" />
                    <DoubleAnimation Storyboard.TargetName="FocusFill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.24" />
                    <DoubleAnimation Storyboard.TargetName="Lens" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0.26" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="MacContextMenuStyle" TargetType="{x:Type ContextMenu}">
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="Grid.IsSharedSizeScope" Value="True" />
    <Setter Property="ContextMenu.HasDropShadow" Value="False" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ContextMenu}">
          <Grid Background="#00FFFFFF">
            <Border Name="MenuBorder" Margin="16" Background="{DynamicResource T.Menu_EA}" BorderBrush="{DynamicResource T.Fg_38}" BorderThickness="1" CornerRadius="12" Padding="5, 6" MinWidth="190">
              <UIElement.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="4" Opacity="0.35" />
              </UIElement.Effect>
              <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="MacMenuItemStyle" TargetType="{x:Type MenuItem}">
    <Setter Property="ToolTipService.InitialShowDelay" Value="650" />
    <Setter Property="ToolTipService.BetweenShowDelay" Value="650" />
    <Setter Property="ToolTipService.ShowDuration" Value="15000" />
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="Foreground" Value="{DynamicResource T.Fg_FF}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Margin" Value="2, 1" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type MenuItem}">
          <Border Name="ItemBorder" Background="#00FFFFFF" CornerRadius="7" Padding="8, 0, 10, 0">
            <Grid VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid Column="0" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ContentPresenter Name="IconHost" ContentSource="Icon" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Path Name="CheckMark" Width="11" Height="9" Stretch="Uniform" Data="M1.5,4.5 L4.2,7.5 L10.5,1.5" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}" />
              </Grid>
              <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" Margin="8, 0, 0, 0" />
              <TextBlock Name="GestureText" Grid.Column="2" Text="{TemplateBinding MenuItem.InputGestureText}" Foreground="{DynamicResource T.Fg_66}" FontSize="11.5" VerticalAlignment="Center" Margin="16, 0, 2, 0" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="MenuItem.IsHighlighted" Value="True">
              <Setter TargetName="ItemBorder" Value="{DynamicResource T.AccPure_FF}" Property="Border.Background" />
              <Setter Value="{DynamicResource T.OnAcc}" Property="Foreground" />
              <Setter TargetName="GestureText" Value="{DynamicResource T.OnAcc}" Property="TextBlock.Foreground" />
            </Trigger>
            <Trigger Property="MenuItem.IsChecked" Value="True">
              <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="UIElement.Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="MacMenuSeparatorStyle" TargetType="{x:Type Separator}">
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="8, 4, 8, 4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Separator}">
          <Border Height="1" Background="{DynamicResource T.Fl_24}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="AppOnlyMenuSeparatorStyle" TargetType="{x:Type Separator}" BasedOn="{StaticResource MacMenuSeparatorStyle}">
    <Style.Triggers>
      <DataTrigger Value="True" Binding="{Binding PlacementTarget.DataContext.IsFolder, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
        <Setter Property="Visibility" Value="Collapsed" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="AppOnlyMenuItemStyle" TargetType="{x:Type MenuItem}" BasedOn="{StaticResource MacMenuItemStyle}">
    <Style.Triggers>
      <DataTrigger Value="True" Binding="{Binding PlacementTarget.DataContext.IsFolder, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
        <Setter Property="Visibility" Value="Collapsed" />
      </DataTrigger>
      <DataTrigger Value="True" Binding="{Binding PlacementTarget.DataContext.IsWidget, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
        <Setter Property="Visibility" Value="Collapsed" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="IconOverrideMenuItemStyle" TargetType="{x:Type MenuItem}" BasedOn="{StaticResource AppOnlyMenuItemStyle}">
    <Setter Property="Visibility" Value="Collapsed" />
    <Style.Triggers>
      <DataTrigger Value="True" Binding="{Binding PlacementTarget.DataContext.HasIconOverride, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
        <Setter Property="Visibility" Value="Visible" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="NameOverrideMenuItemStyle" TargetType="{x:Type MenuItem}" BasedOn="{StaticResource AppOnlyMenuItemStyle}">
    <Setter Property="Visibility" Value="Collapsed" />
    <Style.Triggers>
      <DataTrigger Value="True" Binding="{Binding PlacementTarget.DataContext.HasCustomName, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
        <Setter Property="Visibility" Value="Visible" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="ManualOnlyMenuItemStyle" TargetType="{x:Type MenuItem}" BasedOn="{StaticResource AppOnlyMenuItemStyle}">
    <Setter Property="Visibility" Value="Collapsed" />
    <Style.Triggers>
      <DataTrigger Value="Manual" Binding="{Binding PlacementTarget.DataContext.Source, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
        <Setter Property="Visibility" Value="Visible" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Win32AppOnlyMenuItemStyle" TargetType="{x:Type MenuItem}" BasedOn="{StaticResource MacMenuItemStyle}">
    <Style.Triggers>
      <DataTrigger Value="True" Binding="{Binding PlacementTarget.DataContext.IsFolder, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
        <Setter Property="Visibility" Value="Collapsed" />
      </DataTrigger>
      <DataTrigger Value="True" Binding="{Binding PlacementTarget.DataContext.IsWidget, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
        <Setter Property="Visibility" Value="Collapsed" />
      </DataTrigger>
      <DataTrigger Value="UWP" Binding="{Binding PlacementTarget.DataContext.Source, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
        <Setter Property="Visibility" Value="Collapsed" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="FolderOnlyMenuItemStyle" TargetType="{x:Type MenuItem}" BasedOn="{StaticResource MacMenuItemStyle}">
    <Setter Property="Visibility" Value="Collapsed" />
    <Style.Triggers>
      <DataTrigger Value="True" Binding="{Binding PlacementTarget.DataContext.IsFolder, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
        <Setter Property="Visibility" Value="Visible" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="RootAppOnlyMenuItemStyle" TargetType="{x:Type MenuItem}" BasedOn="{StaticResource MacMenuItemStyle}">
    <Style.Triggers>
      <DataTrigger Value="True" Binding="{Binding PlacementTarget.DataContext.IsFolder, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
        <Setter Property="Visibility" Value="Collapsed" />
      </DataTrigger>
      <DataTrigger Value="True" Binding="{Binding PlacementTarget.DataContext.IsWidget, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
        <Setter Property="Visibility" Value="Collapsed" />
      </DataTrigger>
      <DataTrigger Value="True" Binding="{Binding PlacementTarget.DataContext.IsInFolder, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
        <Setter Property="Visibility" Value="Collapsed" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="InFolderOnlyMenuItemStyle" TargetType="{x:Type MenuItem}" BasedOn="{StaticResource MacMenuItemStyle}">
    <Setter Property="Visibility" Value="Collapsed" />
    <Style.Triggers>
      <DataTrigger Value="True" Binding="{Binding PlacementTarget.DataContext.IsInFolder, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
        <Setter Property="Visibility" Value="Visible" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="WidgetOnlyMenuItemStyle" TargetType="{x:Type MenuItem}" BasedOn="{StaticResource MacMenuItemStyle}">
    <Setter Property="Visibility" Value="Collapsed" />
    <Style.Triggers>
      <DataTrigger Value="True" Binding="{Binding PlacementTarget.DataContext.IsWidget, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
        <Setter Property="Visibility" Value="Visible" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="AppleCapsuleProgressBar" TargetType="{x:Type ProgressBar}">
    <Setter Property="MinHeight" Value="6" />
    <Setter Property="Height" Value="7" />
    <Setter Property="Background" Value="{DynamicResource T.Fl_1A}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ProgressBar}">
          <Border Name="TemplateRoot" CornerRadius="3.5" Background="{TemplateBinding Control.Background}" ClipToBounds="True" SnapsToDevicePixels="True">
            <Grid Name="PART_Track">
              <Decorator Name="PART_Indicator" HorizontalAlignment="Left">
                <Border CornerRadius="3.5" Background="{TemplateBinding Control.Foreground}" />
              </Decorator>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>