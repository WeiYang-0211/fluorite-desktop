<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Launchpad.Views" xmlns:infra="clr-namespace:Launchpad.Infrastructure">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Fluorite;component/Resources/SettingsStyles.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <infra:SceneActiveConverter x:Key="SceneActive" />
  <Style x:Key="WorkspaceButton" TargetType="{x:Type Button}" BasedOn="{StaticResource SheetButton}">
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="UIElement.Opacity" Value="0.4" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="ThemeSuiteCard" TargetType="{x:Type Button}">
    <Setter Property="Background" Value="{DynamicResource T.Fl_0A}" />
    <Setter Property="Foreground" Value="{DynamicResource SheetTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.Fg_14}" />
    <Setter Property="Padding" Value="10" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="Plate" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="1" CornerRadius="12">
            <ContentPresenter Margin="{TemplateBinding Control.Padding}" HorizontalAlignment="Stretch" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Plate" Value="{DynamicResource T.AccText_FF}" Property="Border.BorderBrush" />
            </Trigger>
            <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
              <Setter TargetName="Plate" Value="{DynamicResource T.AccText_FF}" Property="Border.BorderBrush" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Plate" Property="UIElement.Opacity" Value="0.75" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="WorkspaceExpandButton" TargetType="{x:Type Button}">
    <Setter Property="Background" Value="{DynamicResource T.Fl_0A}" />
    <Setter Property="Foreground" Value="{DynamicResource SheetDimBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.Fg_14}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Margin" Value="0,2,6,8" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="Bd" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="10">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Control.Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Bd" Value="{DynamicResource T.Fl_14}" Property="Border.Background" />
              <Setter Value="{DynamicResource SheetTextBrush}" Property="Foreground" />
              <Setter TargetName="Bd" Value="{DynamicResource T.Fg_26}" Property="Border.BorderBrush" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="UIElement.Opacity" Value="0.75" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="WorkspaceScrollBar" TargetType="{x:Type ScrollBar}">
    <Setter Property="Width" Value="8" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ScrollBar}">
          <Track Name="PART_Track" IsDirectionReversed="True">
            <Track.DecreaseRepeatButton>
              <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
            </Track.DecreaseRepeatButton>
            <Track.Thumb>
              <Thumb>
                <Control.Template>
                  <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border Background="{DynamicResource T.Fg_28}" CornerRadius="3" Margin="2,0" />
                  </ControlTemplate>
                </Control.Template>
              </Thumb>
            </Track.Thumb>
            <Track.IncreaseRepeatButton>
              <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
            </Track.IncreaseRepeatButton>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="WorkspaceCardItem" TargetType="{x:Type ListBoxItem}">
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Margin" Value="0,0,6,6" />
    <Setter Property="Foreground" Value="{DynamicResource SheetTextBrush}" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ListBoxItem}">
          <Border Name="Card" Padding="{TemplateBinding Control.Padding}" CornerRadius="10" Background="{DynamicResource T.PresetCard}" BorderBrush="{DynamicResource T.Fg_14}" BorderThickness="1">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Card" Value="{DynamicResource T.PresetHover}" Property="Border.Background" />
            </Trigger>
            <Trigger Property="ListBoxItem.IsSelected" Value="True">
              <Setter TargetName="Card" Value="{DynamicResource AccentBrush}" Property="Border.BorderBrush" />
              <Setter TargetName="Card" Value="{DynamicResource T.PresetSelected}" Property="Border.Background" />
            </Trigger>
            <Trigger Property="UIElement.IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Card" Value="{DynamicResource AccentBrush}" Property="Border.BorderBrush" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="WorkspaceCardList" TargetType="{x:Type ListBox}">
    <Style.Resources>
      <ResourceDictionary>
        <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource WorkspaceScrollBar}" />
      </ResourceDictionary>
    </Style.Resources>
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource WorkspaceCardItem}" />
    <Setter Property="ItemTemplate">
      <Setter.Value>
        <DataTemplate>
          <StackPanel>
            <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding Name}" />
            <TextBlock Margin="0,5,0,0" Style="{StaticResource SHint}" Text="{Binding Detail}" />
          </StackPanel>
        </DataTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ClockPresetCard" TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource WorkspaceCardItem}">
    <Setter Property="Padding" Value="8" />
  </Style>
  <Style x:Key="ClockPresetList" TargetType="{x:Type ListBox}" BasedOn="{StaticResource WorkspaceCardList}">
    <Setter Property="ItemContainerStyle" Value="{StaticResource ClockPresetCard}" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <UniformGrid Columns="3" />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="ItemTemplate">
      <Setter.Value>
        <DataTemplate>
          <StackPanel>
            <Border Background="#00FFFFFF" CornerRadius="9" Padding="2">
              <views:ClockPresetPreview Height="54" Kind="{Binding Value}" Settings="{Binding DataContext.Settings, RelativeSource={RelativeSource AncestorType=ListBox}}" />
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
              <TextBlock FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding Label}" />
              <ContentControl Margin="6,0,0,0" Style="{StaticResource ProBadge}" Visibility="{Binding Pro, Converter={StaticResource Bool2Vis}}" />
            </StackPanel>
          </StackPanel>
        </DataTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <DataTemplate x:Key="WallpaperPresetPicker">
    <StackPanel Margin="0,12,0,0">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <TextBlock Text="官方预设" Style="{StaticResource SLabel}" />
        <ContentControl Margin="8,0,0,0" Style="{StaticResource ProBadge}" />
      </StackPanel>
      <ItemsControl Margin="-3,0,-3,0" ItemsSource="{Binding WallpaperPresets}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="5" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Padding="5" Margin="3,0" Style="{StaticResource ThemeSuiteCard}" Command="{Binding DataContext.SelectPresetWallpaperCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="{Binding Name}">
              <StackPanel>
                <Border Height="58" CornerRadius="6" Background="{Binding Preview}" />
                <TextBlock FontSize="11" TextAlignment="Center" Margin="0,6,0,1" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="AtmosphereSettings">
    <Border Style="{StaticResource SRow}">
      <StackPanel>
        <TextBlock Text="图标动效" Style="{StaticResource STitle}" />
        <TextBlock Text="调整图标的点击与悬浮效果" Margin="0,6,0,14" Style="{StaticResource SHint}" />
        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="点击弹性" VerticalAlignment="Center" Style="{StaticResource STitle}" />
          <ToggleButton Grid.Column="1" Style="{StaticResource MacSwitch}" IsChecked="{Binding Settings.EnableClickSpring, Mode=TwoWay}" />
        </Grid>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="悬浮倾斜与高光" VerticalAlignment="Center" Style="{StaticResource STitle}" />
            <ContentControl Margin="8,0,0,0" Style="{StaticResource ProBadge}" />
          </StackPanel>
          <ToggleButton Grid.Column="1" Style="{StaticResource MacSwitch}" IsChecked="{Binding Settings.EnableIconTilt, Mode=TwoWay}" />
        </Grid>
      </StackPanel>
    </Border>
  </DataTemplate>
  <DataTemplate x:Key="MusicWidgetSettings">
    <Border Padding="16,10" Margin="0,0,0,12" Style="{StaticResource SGroup}">
      <StackPanel>
        <Grid MinHeight="32">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="音乐控制" VerticalAlignment="Center" Style="{StaticResource STitle}" />
          <ComboBox Grid.Column="1" DisplayMemberPath="Display" SelectedValuePath="Value" Style="{StaticResource SettingsChoice}" ItemsSource="{Binding MusicWidgetDisplayChoices}" SelectedValue="{Binding Settings.MusicWidgetDisplayMode, Mode=TwoWay}" />
        </Grid>
        <StackPanel Visibility="{Binding Settings.ShowMusicWidget, Converter={StaticResource Bool2Vis}}">
          <Border Margin="0,10,0,10" Style="{StaticResource SDivider}" />
          <Grid MinHeight="32">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
              <TextBlock Text="频率波" Style="{StaticResource STitle}" />
              <TextBlock Text="播放音乐时，外圈线条随声音起伏" Margin="0,4,0,0" Style="{StaticResource SHint}" />
            </StackPanel>
            <ToggleButton Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource MacSwitch}" IsChecked="{Binding Settings.EnableMusicSpectrum, Mode=TwoWay}" />
          </Grid>
        </StackPanel>
      </StackPanel>
    </Border>
  </DataTemplate>
  <DataTemplate x:Key="ProThemeTools">
    <StackPanel Margin="0,0,0,16">
      <TextBlock Text="主题套装" Margin="0,0,0,6" Style="{StaticResource STitle}" />
      <TextBlock Text="使用默认设置自由配置，或应用 PRO 主题套装" TextWrapping="Wrap" Margin="0,0,0,12" Style="{StaticResource SHint}" />
      <TextBlock Foreground="{DynamicResource T.AccText_FF}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12" Text="{Binding WorkspaceFeedback}" />
      <ItemsControl ItemsSource="{Binding ThemeSuites}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="3" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Padding="10" Margin="0,0,8,8" HorizontalContentAlignment="Stretch" Style="{StaticResource ThemeSuiteCard}" Command="{Binding DataContext.ApplyThemeSuiteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
              <StackPanel>
                <Border CornerRadius="8" Height="76" Background="{Binding Preview}">
                  <Grid>
                    <views:ClockPresetPreview Height="76" ShowBackdrop="False" Kind="{Binding Clock}" />
                    <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6">
                      <ContentControl Style="{StaticResource ProBadge}" Visibility="{Binding Pro, Converter={StaticResource Bool2Vis}}" />
                      <Border Background="#FF273345" CornerRadius="5" Padding="6,2" Visibility="{Binding Pro, Converter={StaticResource InvBool2Vis}}">
                        <TextBlock Text="自定义" Foreground="#FFFFFFFF" FontSize="10" />
                      </Border>
                    </Grid>
                  </Grid>
                </Border>
                <TextBlock Margin="0,9,0,4" Style="{StaticResource STitle}" Text="{Binding Name}" />
                <TextBlock TextWrapping="Wrap" Style="{StaticResource SHint}" Text="{Binding Description}" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Border Padding="16,12" Style="{StaticResource SGroup}">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="精品图标包" Style="{StaticResource STitle}" />
                <ContentControl Margin="8,0,0,0" Style="{StaticResource ProBadge}" />
              </StackPanel>
              <TextBlock Text="原始图标和普通磁贴免费；磨砂玻璃磁贴与整套图标包属于 Pro" TextWrapping="Wrap" Margin="0,5,12,0" Style="{StaticResource SHint}" />
            </StackPanel>
          </Grid>
          <ListBox SelectedValuePath="Id" Margin="0,12,0,0" Style="{StaticResource IconPackCardList}" ItemsSource="{Binding IconPackOptions}" SelectedValue="{Binding SelectedIconPackId, Mode=TwoWay}" />
          <Border Margin="0,12,0,0" Style="{StaticResource SDivider}" />
          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,18,0">
              <TextBlock Text="原图标加磁贴底板" Style="{StaticResource STitle}" />
              <TextBlock Text="关闭和普通免费；磨砂玻璃质感为 Pro 专属，图标包和自定义图标保留原样" TextWrapping="Wrap" Margin="0,4,0,0" Style="{StaticResource SHint}" />
            </StackPanel>
            <ComboBox Grid.Column="1" VerticalAlignment="Center" MinWidth="110" Style="{StaticResource SettingsChoice}" SelectedIndex="{Binding Settings.IconTileMode, Mode=TwoWay}">
              <ComboBoxItem Content="关闭" />
              <ComboBoxItem Content="普通" />
              <ComboBoxItem Content="磨砂 · Pro" />
            </ComboBox>
          </Grid>
          <StackPanel Margin="0,10,0,0" Visibility="{Binding IconPresentation.IsIconStyleSwitching, Converter={StaticResource Bool2Vis}}">
            <TextBlock Margin="0,0,0,6" Style="{StaticResource SHint}" Text="{Binding IconPresentation.IconStyleSwitchStatus}" />
            <ProgressBar Minimum="0" Maximum="100" Height="4" Value="{Binding IconPresentation.IconStyleSwitchProgress}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="ApplicationRemovalTools">
    <Border Padding="16,10" Style="{StaticResource SGroup}">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="移出应用" VerticalAlignment="Center" ToolTip="仅从当前场景的启动台移出，不卸载软件。重新扫描也不会自动添加回来。" Style="{StaticResource STitle}" />
          <Button Grid.Column="1" Content="选择应用…" Style="{StaticResource SheetButton}" Command="{Binding BeginRemoveApplicationsCommand}" Visibility="{Binding IsManagingApplications, Converter={StaticResource InvBool2Vis}}" />
        </Grid>
        <StackPanel Margin="0,10,0,0" Visibility="{Binding IsManagingApplications, Converter={StaticResource Bool2Vis}}">
          <Grid>
            <TextBox Name="RemovalSearchInput" Height="34" MinHeight="34" Padding="34,0,32,0" Background="{DynamicResource T.PresetCard}" AutomationProperties.Name="搜索要移出的应用" Style="{StaticResource SInput}" Text="{Binding RemovalSearch, UpdateSourceTrigger=PropertyChanged}" />
            <Path Data="M10,6 A4,4 0 1 1 2,6A4,4 0 1 1 10,6M9,9 L13,13" Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource SheetDimBrush}" StrokeThickness="1.4" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False" />
            <TextBlock Text="搜索应用名称" Margin="34,0,32,0" VerticalAlignment="Center" IsHitTestVisible="False">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SHint}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <MultiDataTrigger>
                      <MultiDataTrigger.Conditions>
                        <Condition Value="" Binding="{Binding RemovalSearch}" />
                        <Condition Value="False" Binding="{Binding IsKeyboardFocusWithin, ElementName=RemovalSearchInput}" />
                      </MultiDataTrigger.Conditions>
                      <Setter Property="Visibility" Value="Visible" />
                    </MultiDataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </TextBlock>
            <Button Content="×" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0" ToolTip="清空搜索" Background="#00FFFFFF" BorderThickness="0" Foreground="{DynamicResource SheetDimBrush}" Cursor="Hand" Command="{Binding ClearRemovalSearchCommand}">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type Button}">
                  <Setter Property="Visibility" Value="Visible" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="{x:Type Button}">
                        <Border Name="ClearPlate" Background="#00FFFFFF" CornerRadius="6">
                          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="UIElement.IsMouseOver" Value="True">
                            <Setter TargetName="ClearPlate" Value="{DynamicResource T.PresetHover}" Property="Border.Background" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                  <Style.Triggers>
                    <DataTrigger Value="" Binding="{Binding RemovalSearch}">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </Button>
          </Grid>
          <Grid Margin="0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Style="{StaticResource SHint}" Text="{Binding RemovalSelectionText}" />
            <Button Grid.Column="1" Content="全选 / 取消全选" ToolTip="全选筛选结果，再次点击取消全选" Style="{StaticResource SheetButton}" Command="{Binding SelectVisibleApplicationsCommand}" />
          </Grid>
          <Border Background="{DynamicResource T.PresetCard}" CornerRadius="8" Padding="4">
            <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <FrameworkElement.Resources>
                <ResourceDictionary>
                  <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource WorkspaceScrollBar}" />
                </ResourceDictionary>
              </FrameworkElement.Resources>
              <ItemsControl ItemsSource="{Binding VisibleRemovalChoices}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <ToggleButton HorizontalContentAlignment="Stretch" Margin="0,1" Cursor="Hand" IsChecked="{Binding IsSelected, Mode=TwoWay}" ToolTip="{Binding App.ExecutablePath}">
                      <Control.Template>
                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                          <Border Name="Plate" Padding="10,7" CornerRadius="7" Background="#00FFFFFF">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <Border Name="CheckPlate" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource T.Fg_4D}">
                                <Path Name="Mark" Data="M0,4 L3,7 L9,0" Width="9" Height="7" Stretch="Uniform" Stroke="#FFFFFFFF" StrokeThickness="1.5" Visibility="Collapsed" />
                              </Border>
                              <Image Grid.Column="1" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Source="{Binding App.Icon}" />
                              <TextBlock Grid.Column="2" Foreground="{DynamicResource SheetTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Text="{Binding App.DisplayName}" />
                            </Grid>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="UIElement.IsMouseOver" Value="True">
                              <Setter TargetName="Plate" Value="{DynamicResource T.PresetHover}" Property="Border.Background" />
                            </Trigger>
                            <Trigger Property="ToggleButton.IsChecked" Value="True">
                              <Setter TargetName="Plate" Value="{DynamicResource AccentDimBrush}" Property="Border.Background" />
                              <Setter TargetName="CheckPlate" Value="{DynamicResource AccentBrush}" Property="Border.Background" />
                              <Setter TargetName="Mark" Property="UIElement.Visibility" Value="Visible" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Control.Template>
                    </ToggleButton>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="取消" Margin="0,0,8,0" Style="{StaticResource SheetButton}" Command="{Binding CancelRemoveApplicationsCommand}" />
            <Button Content="移出所选" ToolTip="移出当前场景，不卸载软件" Style="{StaticResource SheetDestructiveButton}" Command="{Binding RemoveSelectedApplicationsCommand}" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Border>
  </DataTemplate>
  <DataTemplate x:Key="ProLayoutTools">
    <Border Padding="16,12" Margin="0,0,0,16" Style="{StaticResource SGroup}">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="我的场景" ToolTip="为工作与闲暇保存桌面；切换前自动保存当前状态。" Style="{StaticResource STitle}" />
            <ContentControl Margin="8,0,0,0" Style="{StaticResource ProBadge}" />
            <ContentControl ToolTip="拖动场景行调整顺序，新场景追加到末尾。&#xA;Ctrl + 1–9：按列表顺序直达场景；Ctrl + 0：第 10 个场景。&#xA;Ctrl + ← / →：循环切换场景。&#xA;快捷键仅在启动台内生效，输入文字时不切换；切换前自动保存当前场景。" Style="{StaticResource HelpTip}" />
          </StackPanel>
          <TextBlock Grid.Column="1" VerticalAlignment="Center" ToolTip="切换时自动保存当前场景；每个场景分别保存外观、排列和程序坞" Style="{StaticResource SHint}" Text="{Binding CurrentSceneText}" />
        </Grid>
        <ListBox Margin="0,10,0,0" views:SceneListDrag.Enabled="True" AlternationCount="10000" ScrollViewer.VerticalScrollBarVisibility="Disabled" Style="{StaticResource WorkspaceCardList}" ItemsSource="{Binding LayoutPresets}" SelectedItem="{Binding SelectedLayout}">
          <ItemsControl.ItemContainerStyle>
            <Style TargetType="{x:Type ListBoxItem}">
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Margin" Value="0,0,0,5" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border Name="Card" CornerRadius="8" Padding="12,8" Background="{DynamicResource T.PresetCard}" BorderBrush="{DynamicResource T.Fg_14}" BorderThickness="1">
                      <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="UIElement.IsMouseOver" Value="True">
                        <Setter TargetName="Card" Value="{DynamicResource T.PresetHover}" Property="Border.Background" />
                      </Trigger>
                      <Trigger Property="ListBoxItem.IsSelected" Value="True">
                        <Setter TargetName="Card" Value="{DynamicResource AccentBrush}" Property="Border.BorderBrush" />
                      </Trigger>
                      <DataTrigger Value="True">
                        <DataTrigger.Binding>
                          <MultiBinding Converter="{StaticResource SceneActive}">
                            <Binding Path="Id" />
                            <Binding Path="DataContext.Settings.ActiveLayoutId" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                          </MultiBinding>
                        </DataTrigger.Binding>
                        <Setter TargetName="Card" Value="{DynamicResource T.PresetSelected}" Property="Border.Background" />
                        <Setter TargetName="Card" Value="{DynamicResource AccentBrush}" Property="Border.BorderBrush" />
                      </DataTrigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ItemsControl.ItemContainerStyle>
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Foreground="{DynamicResource SheetTextBrush}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0" Text="{Binding Name, StringFormat=⋮⋮  {0}}">
                  <FrameworkElement.ToolTip>
                    <StackPanel>
                      <TextBlock Text="{Binding Summary}" />
                      <TextBlock Text="{Binding Detail, StringFormat=更新于 {0}}" />
                    </StackPanel>
                  </FrameworkElement.ToolTip>
                </TextBlock>
                <TextBlock Grid.Column="1" Text="当前" Foreground="{DynamicResource SheetAccentBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0">
                  <FrameworkElement.Style>
                    <Style TargetType="{x:Type TextBlock}">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Value="True">
                          <DataTrigger.Binding>
                            <MultiBinding Converter="{StaticResource SceneActive}">
                              <Binding Path="Id" />
                              <Binding Path="DataContext.Settings.ActiveLayoutId" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                            </MultiBinding>
                          </DataTrigger.Binding>
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </FrameworkElement.Style>
                </TextBlock>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                  <Button Content="切换" Margin="0,0,6,0" Style="{StaticResource WorkspaceButton}" Command="{Binding DataContext.UseLayoutEntryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                  <Button Content="⋯" FontSize="18" Width="34" Padding="0" ToolTip="更多操作" AutomationProperties.Name="场景更多操作" views:SettingsMoreMenu.Enabled="True" Style="{StaticResource WorkspaceButton}" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}">
                    <FrameworkElement.ContextMenu>
                      <ContextMenu Style="{StaticResource MacContextMenuStyle}">
                        <MenuItem Header="改名" Style="{StaticResource MacMenuItemStyle}" Command="{Binding PlacementTarget.Tag.RenameLayoutEntryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="删除" ToolTip="删除前自动备份" Style="{StaticResource MacMenuItemStyle}" Command="{Binding PlacementTarget.Tag.DeleteLayoutEntryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                      </ContextMenu>
                    </FrameworkElement.ContextMenu>
                  </Button>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ListBox>
        <Button Content="＋ 新增场景" HorizontalAlignment="Left" Margin="0,6,0,0" Style="{StaticResource WorkspaceButton}" Command="{Binding BeginAddLayoutCommand}" Visibility="{Binding IsAddingLayout, Converter={StaticResource InvBool2Vis}}" />
        <Border Background="{DynamicResource T.PresetCard}" CornerRadius="10" Padding="12" Margin="0,6,0,0" Visibility="{Binding IsAddingLayout, Converter={StaticResource Bool2Vis}}">
          <StackPanel>
            <TextBlock Margin="0,0,0,8" Style="{StaticResource STitle}" Text="{Binding SceneEditorTitle}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox MaxLength="32" ToolTip="场景名称，例如工作、游戏、专注" AutomationProperties.Name="新场景名称" Style="{StaticResource SInput}" Text="{Binding LayoutName, UpdateSourceTrigger=PropertyChanged}" />
              <Button Grid.Column="1" Content="保存" Margin="10,0,0,0" Style="{StaticResource WorkspaceButton}" Command="{Binding SaveLayoutCommand}" />
              <Button Grid.Column="2" Content="取消" Margin="6,0,0,0" Style="{StaticResource WorkspaceButton}" Command="{Binding CancelAddLayoutCommand}" />
            </Grid>
          </StackPanel>
        </Border>
        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Text="{Binding WorkspaceFeedback}">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SHint}">
              <Style.Triggers>
                <DataTrigger Value="" Binding="{Binding WorkspaceFeedback}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding WorkspaceFeedback}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </TextBlock>
      </StackPanel>
    </Border>
  </DataTemplate>
  <DataTemplate x:Key="ProBackupTools">
    <StackPanel Margin="0">
      <Border Padding="16,13" Margin="0,0,0,12" Style="{StaticResource SGroup}">
        <StackPanel>
          <TextBlock Text="备份与迁移" FontWeight="SemiBold" FontSize="13.5" Style="{StaticResource STitle}" />
          <TextBlock Text="换台电脑也能带走熟悉的桌面；基础外观免费，完整备份属于 Pro。" Margin="0,3,0,10" Style="{StaticResource SHint}" />
          <UniformGrid Columns="3">
            <Button Margin="0,0,8,0" Height="34" ToolTip="基础外观与偏好 · 免费" Style="{StaticResource SheetButton}" Command="{Binding ExportBasicSettingsCommand}">
              <TextBlock Text="导出设置" VerticalAlignment="Center" />
            </Button>
            <Button Margin="0,0,8,0" Height="34" ToolTip="从备份文件恢复桌面" Style="{StaticResource SheetButton}" Command="{Binding ImportWorkspaceCommand}">
              <TextBlock Text="导入配置" VerticalAlignment="Center" />
            </Button>
            <Button Height="34" ToolTip="布局、背景与图标资源" Style="{StaticResource SheetButton}" Command="{Binding ExportCompleteBackupCommand}">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="完整备份" VerticalAlignment="Center" />
                <ContentControl Margin="6,0,0,0" VerticalAlignment="Center" Style="{StaticResource ProBadge}" />
              </StackPanel>
            </Button>
          </UniformGrid>
          <TextBlock Text="备份不包含许可证、应用或文档本体。" Margin="0,8,0,0" Style="{StaticResource SHint}" />
        </StackPanel>
      </Border>
      <Border Padding="16,14" Margin="0,0,0,12" Style="{StaticResource SGroup}">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="桌面时光机" FontWeight="SemiBold" FontSize="13.5" ToolTip="恢复前自动保存当前状态；保留最近 20 个版本，快照到期后仍保留。" Style="{StaticResource STitle}" />
              <ContentControl Margin="8,0,0,0" Style="{StaticResource ProBadge}" />
            </StackPanel>
            <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource SHint}" Text="{Binding BackupHistory.Count, StringFormat=已保存 {0} / 20}" />
          </Grid>
          <Grid Margin="0,8,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox MaxLength="32" ToolTip="为快照起个名字，方便以后找到" Style="{StaticResource SInput}" Text="{Binding SnapshotName, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1" Content="保存当前桌面" Margin="10,0,0,0" Style="{StaticResource WorkspaceButton}" Command="{Binding SaveSnapshotCommand}" />
          </Grid>
          <Border Background="{DynamicResource T.PresetSelected}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type Border}">
                <Style.Triggers>
                  <DataTrigger Value="" Binding="{Binding WorkspaceFeedback}">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
            <TextBlock Foreground="{DynamicResource SheetTextBrush}" FontSize="12" TextWrapping="Wrap" Text="{Binding WorkspaceFeedback}" />
          </Border>
          <ListBox ScrollViewer.VerticalScrollBarVisibility="Disabled" Style="{StaticResource WorkspaceCardList}" ItemsSource="{Binding VisibleBackupHistory}" SelectedItem="{Binding SelectedBackup}">
            <ItemsControl.ItemContainerStyle>
              <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource WorkspaceCardItem}">
                <Setter Property="Padding" Value="12,7" />
                <Setter Property="Margin" Value="0,0,0,4" />
              </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0" Text="{Binding Name}" ToolTip="{Binding Summary}" />
                  <TextBlock Grid.Column="1" FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0" Style="{StaticResource SHint}" Text="{Binding Detail}" />
                  <Button Grid.Column="2" Content="恢复" Padding="10,4" MinHeight="28" ToolTip="{Binding Kind}" Command="{Binding DataContext.RestoreHistoryEntryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}">
                    <FrameworkElement.Style>
                      <Style TargetType="{x:Type Button}" BasedOn="{StaticResource WorkspaceButton}">
                        <Style.Triggers>
                          <DataTrigger Value="True" Binding="{Binding DataContext.WorkspaceBusy, RelativeSource={RelativeSource AncestorType=ListBox}}">
                            <Setter Property="IsEnabled" Value="False" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkElement.Style>
                  </Button>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ListBox>
          <Button Style="{StaticResource WorkspaceExpandButton}" Content="{Binding BackupHistoryExpandText}" Command="{Binding ToggleBackupHistoryExpandedCommand}" Visibility="{Binding HasMoreBackupHistory, Converter={StaticResource Bool2Vis}}" />
          <TextBlock Text="还没有历史记录。保存你的第一份桌面快照，从这里开始。" TextWrapping="Wrap" Margin="0,4,0,12">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SHint}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Value="0" Binding="{Binding BackupHistory.Count}">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </TextBlock>
        </StackPanel>
      </Border>
    </StackPanel>
  </DataTemplate>
</ResourceDictionary>