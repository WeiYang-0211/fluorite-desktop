    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="Margin" Value="6,0,0,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FrameworkElement.Cursor" Value="Help" />
    <Setter Property="ToolTipService.InitialShowDelay" Value="100" />
    <Setter Property="ToolTipService.BetweenShowDelay" Value="100" />
    <Setter Property="ToolTipService.ShowDuration" Value="30000" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ContentControl}">
          <Border Name="Bd" Width="14" Height="14" CornerRadius="7" Background="{DynamicResource T.Fl_14}" BorderBrush="{DynamicResource T.Fg_26}" BorderThickness="1" SnapsToDevicePixels="True">
            <TextBlock Name="Txt" Text="?" FontSize="9.5" FontWeight="SemiBold" FontFamily="{DynamicResource AppFont}" Foreground="{DynamicResource T.Fg_80}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-0.5,0,0" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Bd" Value="{DynamicResource T.Fl_2E}" Property="Border.Background" />
              <Setter TargetName="Bd" Value="{DynamicResource T.Fg_4D}" Property="Border.BorderBrush" />
              <Setter TargetName="Txt" Value="{DynamicResource T.Fg_F5}" Property="TextBlock.Foreground" />
