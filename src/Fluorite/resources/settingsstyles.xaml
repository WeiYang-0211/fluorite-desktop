  <Style x:Key="SInput" TargetType="{x:Type TextBox}">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
    <Setter Property="Foreground" Value="{DynamicResource T.Fg_F5}" />
    <Setter Property="TextBoxBase.CaretBrush" Value="{DynamicResource T.Fg_F5}" />
    <Setter Property="TextBoxBase.SelectionBrush" Value="{DynamicResource T.AccText_FF}" />
    <Setter Property="Background" Value="{DynamicResource T.Fl_10}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.Fg_1A}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="UIElement.AllowDrop" Value="True" />
    <Setter Property="TextBoxBase.IsInactiveSelectionHighlightEnabled" Value="True" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TextBox}">
          <Border Name="Bd" CornerRadius="8" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" SnapsToDevicePixels="True">
            <ScrollViewer Name="PART_ContentHost" Focusable="False" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" HorizontalAlignment="Stretch" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" Margin="{TemplateBinding Control.Padding}" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Value="{DynamicResource T.Fg_66}" Property="Border.BorderBrush" />
              <Setter TargetName="Bd" Value="{DynamicResource T.Fl_1A}" Property="Border.Background" />
            </Trigger>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Bd" Value="{DynamicResource T.Fg_28}" Property="Border.BorderBrush" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Value="{DynamicResource SheetDimBrush}" Property="Foreground" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="HotkeyButton" TargetType="{x:Type Button}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource T.Fg_F5}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="13,5" />
    <Setter Property="Background" Value="{DynamicResource T.Fl_1E}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.Fg_28}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="Bd" CornerRadius="7" BorderThickness="{TemplateBinding Control.BorderThickness}" BorderBrush="{TemplateBinding Control.BorderBrush}" Background="{TemplateBinding Control.Background}" Padding="{TemplateBinding Control.Padding}" RenderTransformOrigin="0.5, 0.5" SnapsToDevicePixels="True">
            <UIElement.RenderTransform>
              <ScaleTransform ScaleX="1" ScaleY="1" />
            </UIElement.RenderTransform>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.Foreground="{TemplateBinding Control.Foreground}" TextBlock.FontSize="{TemplateBinding Control.FontSize}" TextBlock.FontWeight="{TemplateBinding Control.FontWeight}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Bd" Value="{DynamicResource T.Fl_2E}" Property="Border.Background" />
              <Setter TargetName="Bd" Value="{DynamicResource T.Fg_66}" Property="Border.BorderBrush" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Value="{DynamicResource T.Fl_38}" Property="Border.Background" />
              <Setter TargetName="Bd" Value="{DynamicResource T.Fg_8A}" Property="Border.BorderBrush" />
              <Setter TargetName="Bd" Property="RenderTransform">
                <Setter.Value>
                  <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <DataTrigger Value="True" Binding="{Binding IsCapturingHotkey}">
              <Setter TargetName="Bd" Value="{DynamicResource AccentBrush}" Property="Border.Background" />
              <Setter TargetName="Bd" Value="{DynamicResource T.SbRing_33}" Property="Border.BorderBrush" />
              <Setter Property="Foreground" Value="#FFFFFF" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="MacSwitch" TargetType="{x:Type ToggleButton}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <Border Name="TrackBg" Width="38" Height="22" CornerRadius="11" Background="{DynamicResource T.Fl_24}" BorderThickness="0">
            <Grid>
              <Border Name="Knob" Width="18" Height="18" CornerRadius="9" HorizontalAlignment="Left" Margin="2,0,0,0" Background="{DynamicResource T.Knob}" RenderTransformOrigin="0.5, 0.5">
                <UIElement.Effect>
                  <DropShadowEffect BlurRadius="2.5" ShadowDepth="0.8" Direction="270" Opacity="0.26" Color="#000000" />
                </UIElement.Effect>
                <UIElement.RenderTransform>
                  <TransformGroup>
                    <TranslateTransform x:Name="KnobShift" X="0" />
                    <ScaleTransform x:Name="KnobPress" ScaleX="1" ScaleY="1" />
                  </TransformGroup>
                </UIElement.RenderTransform>
              </Border>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="TrackBg" Value="{DynamicResource T.Fl_33}" Property="Border.Background" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="KnobPress" Storyboard.TargetProperty="ScaleX" To="1.10" Duration="0:0:0.08" />
                    <DoubleAnimation Storyboard.TargetName="KnobPress" Storyboard.TargetProperty="ScaleY" To="0.95" Duration="0:0:0.08" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="KnobPress" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18">
                      <DoubleAnimation.EasingFunction>
                        <infra:SpringEase Bounce="0.24" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="KnobPress" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18">
                      <DoubleAnimation.EasingFunction>
                        <infra:SpringEase Bounce="0.24" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter TargetName="TrackBg" Value="{DynamicResource AccentBrush}" Property="Border.Background" />
              <Setter TargetName="TrackBg" Value="{DynamicResource T.SbRing_33}" Property="Border.BorderBrush" />
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X" To="16" Duration="0:0:0.18">
                      <DoubleAnimation.EasingFunction>
                        <infra:SpringEase Bounce="0.12" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18">
                      <DoubleAnimation.EasingFunction>
                        <infra:SpringEase Bounce="0" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ChipItem" TargetType="{x:Type ListBoxItem}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Foreground" Value="{DynamicResource T.SbSel_B3}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ListBoxItem}">
          <Grid Margin="1" Background="#00FFFFFF">
            <Border Name="Sel" Opacity="0" CornerRadius="7" BorderThickness="0" Background="{DynamicResource AccentBrush}" IsHitTestVisible="False" />
            <Border Name="Bd" Background="#00FFFFFF" BorderThickness="0" CornerRadius="7" Padding="14,6">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Bd" Value="{DynamicResource T.Fl_1A}" Property="Border.Background" />
              <Setter Value="{DynamicResource T.Fg_FF}" Property="Foreground" />
            </Trigger>
            <Trigger Property="ListBoxItem.IsSelected" Value="True">
              <Setter Value="{DynamicResource T.OnAcc}" Property="Foreground" />
              <Setter Property="FontWeight" Value="SemiBold" />
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.13" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.13" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ChipList" TargetType="{x:Type ListBox}">
    <Setter Property="Background" Value="{DynamicResource T.Sheet_FF}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="3" />
