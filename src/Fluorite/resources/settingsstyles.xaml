  <Style x:Key="SheetClose" TargetType="{x:Type Button}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="Bd" Width="30" Height="30" CornerRadius="15" BorderThickness="0" Background="{DynamicResource T.Fl_14}">
            <Grid>
              <Path Name="Glyph" Width="9.5" Height="9.5" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.78" Fill="{DynamicResource T.Fg_D9}" Data="M19,6.41 L17.59,5 L12,10.59 L6.41,5 L5,6.41 L10.59,12 L5,17.59 L6.41,19 L12,13.41 L17.59,19 L19,17.59 L13.41,12 L19,6.41" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Bd" Value="{DynamicResource T.Fl_2E}" Property="Border.Background" />
              <Setter TargetName="Glyph" Property="UIElement.Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Value="{DynamicResource T.Fl_38}" Property="Border.Background" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="IconPackCardItem" TargetType="{x:Type ListBoxItem}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="Margin" Value="0,0,16,12" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ListBoxItem}">
          <Grid Name="CardRoot" Width="290">
            <Border Name="CardBorder" CornerRadius="14" Background="{DynamicResource T.Fl_14}" BorderBrush="{DynamicResource T.Fg_14}" BorderThickness="1.5" Padding="14,12,14,12">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Row="0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource T.Fg_F5}" VerticalAlignment="Center" Text="{Binding Display}" />
                  <Border Name="TagBorder" Grid.Column="1" Margin="8,0,0,0" Padding="6,2" CornerRadius="5" Background="{DynamicResource T.Fl_1E}" VerticalAlignment="Center">
                    <TextBlock Name="TagText" FontSize="11" Foreground="{DynamicResource T.Fg_8A}" Text="{Binding Tag}" />
                  </Border>
                  <Border Name="CheckBadge" Grid.Column="3" Width="20" Height="20" CornerRadius="10" Background="{DynamicResource AccentBrush}" Visibility="Collapsed" VerticalAlignment="Center">
                    <Path Data="M4,9.5 L7.5,13 L14,6.5" Stroke="#FFFFFF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                  </Border>
                </Grid>
                <TextBlock Grid.Row="1" FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource T.Fg_66}" TextTrimming="CharacterEllipsis" Text="{Binding Description}" />
                <Border Grid.Row="2" Margin="0,10,0,0" CornerRadius="9" Background="{DynamicResource T.Fl_0A}" BorderBrush="{DynamicResource T.Fg_0A}" BorderThickness="1" Padding="6,7">
                  <ItemsControl HorizontalAlignment="Center" VerticalAlignment="Center" ItemsSource="{Binding Previews}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Width="38" Height="38" Margin="4,0" CornerRadius="8" Background="{DynamicResource T.Fl_0A}" SnapsToDevicePixels="True">
                          <Image Width="32" Height="32" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center" Source="{Binding}" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
              </Grid>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="CardBorder" Value="{DynamicResource T.Fl_24}" Property="Border.Background" />
              <Setter TargetName="CardBorder" Value="{DynamicResource T.Fg_28}" Property="Border.BorderBrush" />
            </Trigger>
            <Trigger Property="ListBoxItem.IsSelected" Value="True">
              <Setter TargetName="CardBorder" Value="{DynamicResource AccentBrush}" Property="Border.BorderBrush" />
              <Setter TargetName="CardBorder" Value="{DynamicResource T.Fl_2E}" Property="Border.Background" />
              <Setter TargetName="CheckBadge" Property="Visibility" Value="Visible" />
              <Setter TargetName="TagBorder" Value="{DynamicResource T.ActiveChip}" Property="Border.Background" />
              <Setter TargetName="TagText" Value="{DynamicResource AccentBrush}" Property="TextBlock.Foreground" />
              <Setter TargetName="TagText" Property="TextBlock.FontWeight" Value="SemiBold" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="IconPackCardList" TargetType="{x:Type ListBox}">
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="ItemContainerStyle" Value="{StaticResource IconPackCardItem}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ListBox}">
          <ItemsPresenter />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>