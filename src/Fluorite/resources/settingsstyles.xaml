  <Style x:Key="{x:Type ComboBox}" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource SettingsChoice}" />
  <Style x:Key="SliderDecreaseBar" TargetType="{x:Type RepeatButton}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Background" Value="{DynamicResource SliderFillBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RepeatButton}">
          <Border Height="4" CornerRadius="2,0,0,2" Margin="0,0,-8,0" Background="{TemplateBinding Control.Background}" VerticalAlignment="Center" SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SliderBar" TargetType="{x:Type RepeatButton}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RepeatButton}">
          <Border Height="4" CornerRadius="2" Background="{TemplateBinding Control.Background}" VerticalAlignment="Center" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SliderThumb" TargetType="{x:Type Thumb}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Grid Width="18" Height="24" Background="#00FFFFFF" SnapsToDevicePixels="True">
            <Border Name="Knob" Width="18" Height="18" CornerRadius="9" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True" RenderTransformOrigin="0.5, 0.5" BorderThickness="0.6">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="#FFFFFF" Offset="0.0" />
                  <GradientStop Color="#FDFDFD" Offset="0.5" />
                  <GradientStop Color="#EFEFF2" Offset="1.0" />
                </LinearGradientBrush>
              </Border.Background>
              <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="#30000000" Offset="0.0" />
                  <GradientStop Color="#48000000" Offset="1.0" />
                </LinearGradientBrush>
              </Border.BorderBrush>
              <UIElement.Effect>
                <DropShadowEffect x:Name="KnobShadow" BlurRadius="4" ShadowDepth="1.5" Direction="270" Opacity="0.28" Color="#000000" />
              </UIElement.Effect>
              <UIElement.RenderTransform>
                <ScaleTransform x:Name="KnobScale" ScaleX="1" ScaleY="1" />
              </UIElement.RenderTransform>
              <Border CornerRadius="8.4" BorderThickness="0.6,0.6,0.6,0" BorderBrush="#80FFFFFF" Background="#00FFFFFF" SnapsToDevicePixels="True" />
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="KnobScale" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.10" />
                    <DoubleAnimation Storyboard.TargetName="KnobScale" Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.10" />
                    <DoubleAnimation Storyboard.TargetName="KnobShadow" Storyboard.TargetProperty="Opacity" To="0.36" Duration="0:0:0.10" />
                    <DoubleAnimation Storyboard.TargetName="KnobShadow" Storyboard.TargetProperty="BlurRadius" To="5.5" Duration="0:0:0.10" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="KnobScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.14" />
                    <DoubleAnimation Storyboard.TargetName="KnobScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.14" />
                    <DoubleAnimation Storyboard.TargetName="KnobShadow" Storyboard.TargetProperty="Opacity" To="0.28" Duration="0:0:0.14" />
                    <DoubleAnimation Storyboard.TargetName="KnobShadow" Storyboard.TargetProperty="BlurRadius" To="4" Duration="0:0:0.14" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </Trigger>
            <Trigger Property="Thumb.IsDragging" Value="True">
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="KnobScale" Storyboard.TargetProperty="ScaleX" To="1.10" Duration="0:0:0.06" />
                    <DoubleAnimation Storyboard.TargetName="KnobScale" Storyboard.TargetProperty="ScaleY" To="1.10" Duration="0:0:0.06" />
                    <DoubleAnimation Storyboard.TargetName="KnobShadow" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0:0:0.06" />
                    <DoubleAnimation Storyboard.TargetName="KnobShadow" Storyboard.TargetProperty="BlurRadius" To="6.5" Duration="0:0:0.06" />
                    <DoubleAnimation Storyboard.TargetName="KnobShadow" Storyboard.TargetProperty="ShadowDepth" To="2.0" Duration="0:0:0.06" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="KnobScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.14" />
                    <DoubleAnimation Storyboard.TargetName="KnobScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.14" />
                    <DoubleAnimation Storyboard.TargetName="KnobShadow" Storyboard.TargetProperty="Opacity" To="0.28" Duration="0:0:0.14" />
                    <DoubleAnimation Storyboard.TargetName="KnobShadow" Storyboard.TargetProperty="BlurRadius" To="4" Duration="0:0:0.14" />
                    <DoubleAnimation Storyboard.TargetName="KnobShadow" Storyboard.TargetProperty="ShadowDepth" To="1.5" Duration="0:0:0.14" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="MacSlider" TargetType="{x:Type Slider}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Slider.IsMoveToPointEnabled" Value="True" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Slider}">
          <Grid Height="24" Background="#00FFFFFF">
            <Border Height="4" CornerRadius="2" Background="{DynamicResource T.Fl_1A}" VerticalAlignment="Center" SnapsToDevicePixels="True" />
            <Track Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderDecreaseBar}" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource SliderThumb}" />
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderBar}" />
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SidebarItem" TargetType="{x:Type ListBoxItem}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource T.Fg_D9}" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ListBoxItem}">
          <Border Name="Bd" Background="#00FFFFFF" BorderThickness="0" CornerRadius="8" Padding="13,7" Margin="10,2">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Bd" Value="{DynamicResource T.Rp_1F}" Property="Border.Background" />
              <Setter Value="{DynamicResource T.Fg_F0}" Property="Foreground" />
            </Trigger>
            <Trigger Property="ListBoxItem.IsSelected" Value="True">
              <Setter TargetName="Bd" Value="{DynamicResource AccentBrush}" Property="Border.Background" />
              <Setter Value="{DynamicResource T.OnAcc}" Property="Foreground" />
