  <Style x:Key="SidebarList" TargetType="{x:Type ListBox}">
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource SidebarItem}" />
    <Setter Property="ItemTemplate">
      <Setter.Value>
        <DataTemplate>
          <StackPanel Orientation="Horizontal">
            <Viewbox Width="19" Height="19" Margin="0,0,11,0" VerticalAlignment="Center">
              <Grid Width="24" Height="24">
                <Path Stretch="None" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Data="{Binding Converter={StaticResource SectionIcon}}" />
              </Grid>
            </Viewbox>
            <TextBlock VerticalAlignment="Center" Text="{Binding}" />
          </StackPanel>
        </DataTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ListBox}">
          <ItemsPresenter />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <StackPanel />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SidebarModeButton" TargetType="{x:Type Button}">
    <Setter Property="Foreground" Value="{DynamicResource T.Fg_D9}" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="MinHeight" Value="46" />
    <Setter Property="FrameworkElement.ToolTip" Value="切换常用设置与全部设置" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="ModeBorder" CornerRadius="10" Padding="12,10" Background="{DynamicResource T.Fl_0A}" BorderBrush="{DynamicResource T.Fg_1A}" BorderThickness="1">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Name="ModeLabel" Text="更多设置" Foreground="{TemplateBinding Control.Foreground}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Path Name="ModeArrow" Grid.Column="1" Width="7" Height="12" Stretch="Uniform" Data="M2,2 L7,7 L2,12" Stroke="{TemplateBinding Control.Foreground}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" Margin="10,0,0,0" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="ModeBorder" Value="{DynamicResource T.Rp_1F}" Property="Border.Background" />
            </Trigger>
            <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
              <Setter TargetName="ModeBorder" Value="{DynamicResource AccentBrush}" Property="Border.BorderBrush" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="ModeBorder" Property="UIElement.Opacity" Value="0.75" />
            </Trigger>
            <DataTrigger Value="True" Binding="{Binding ShowAdvancedSettings}">
              <Setter TargetName="ModeLabel" Property="TextBlock.Text" Value="返回常用设置" />
              <Setter TargetName="ModeArrow" Property="Path.Data" Value="M7,2 L2,7 L7,12" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SheetButton" TargetType="{x:Type Button}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource T.Fg_FF}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="Background" Value="{DynamicResource T.Fl_14}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.Fg_26}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="Bd" CornerRadius="6" BorderThickness="{TemplateBinding Control.BorderThickness}" BorderBrush="{TemplateBinding Control.BorderBrush}" Background="#00FFFFFF" RenderTransformOrigin="0.5, 0.5" SnapsToDevicePixels="True">
            <UIElement.Effect>
              <DropShadowEffect BlurRadius="2.5" ShadowDepth="1" Direction="270" Opacity="0.14" Color="#000000" />
            </UIElement.Effect>
            <UIElement.RenderTransform>
              <ScaleTransform ScaleX="1" ScaleY="1" />
            </UIElement.RenderTransform>
            <Grid>
              <Border CornerRadius="5" Background="{TemplateBinding Control.Background}" />
              <Border Name="Lift" CornerRadius="5" Opacity="0" Background="{DynamicResource T.Rp_1F}" />
              <ContentPresenter Margin="{TemplateBinding Control.Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="RenderTransform">
                <Setter.Value>
                  <ScaleTransform ScaleX="0.965" ScaleY="0.965" />
                </Setter.Value>
              </Setter>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
